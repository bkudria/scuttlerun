{
  "name": "scuttlerun",
  "version": "0.3.0",
  "description": "Multi-turn Claude session driver",
  "keywords": [
    "claude",
    "anthropic",
    "agent-sdk",
    "cli",
    "llm",
    "ai",
    "agent",
    "synthetic-user",
    "multi-turn",
    "headless",
    "transcript",
    "evaluation",
    "automation"
  ],
  "author": "Benjamin Kudria <ben@kudria.net>",
  "contributors": [],
  "license": "MIT",
  "homepage": "https://github.com/bkudria/scuttlerun#readme",
  "bugs": {
    "url": "https://github.com/bkudria/scuttlerun/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bkudria/scuttlerun.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "scuttlerun": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc && chmod +x dist/cli.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "tsx src/cli.ts",
    "prepare": "husky",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.143",
    "@anthropic-ai/sdk": "^0.105.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^15.0.0",
    "word-wrap": "^1.2.5",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.2",
    "vitest": "^4.1.4"
  }
}
