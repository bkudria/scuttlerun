-- allium: 3
-- scuttlerun.allium
--
-- Scope: Behaviour of the scuttlerun session driver from invocation to
-- termination. Distilled from src/ as of commit fed8d50.
--
-- Includes:
--   - Session lifecycle and outcome-to-exit-code mapping
--   - Synthetic user answering AskUserQuestion via an LLM oracle
--   - Reactive turn policy (oracle-driven follow-ups, capped per session)
--   - Workspace lifecycle: scaffold-or-bare, preservation, stale GC
--   - Cost accumulation across agent and oracle
--   - Streaming transcript shape (preamble / conversation / footer)
--   - Credential preference (auth mode) shaping which credential the agent
--     session and the oracle authenticate with
--
-- Excludes:
--   - YAML config schema and merge semantics (input presentation, not behaviour)
--   - Agent SDK protocol internals (message envelopes, async-iterator coordination)
--   - Oracle SDK call mechanics beyond the credential surface, host
--     configuration isolation and retry policy captured here (one-shot
--     query plumbing, structured-output
--     round trips, and the hand-written JSON schema mirroring the Zod
--     validators)
--   - Sandbox enforcement (delegated to the Agent SDK; scuttlerun configures the sandbox via SessionInput.sandbox)
--   - Model pricing (the Agent SDK prices every agent and oracle query;
--     scuttlerun reads the SDK's estimate rather than pricing tokens itself)

-- Self-reference. scuttlerun's external entities (AgentSdkClient,
-- OracleSdkClient, Environment, Caller) sit at code-to-code or
-- shell-to-process boundaries; their governing specifications are upstream
-- non-Allium artefacts (the Agent SDK TypeScript types for both the agent
-- session and the one-shot oracle query, the operating system shell,
-- filesystem and Keychain for the credential environment, and the operating
-- system process model respectively). This declaration anchors the module
-- to a known coordinate so the checker's missing-source-hint heuristic is
-- satisfied without inventing fictitious upstream Allium specs.
use "./scuttlerun.allium" as scuttlerun


-- =============================================================
-- Given
-- =============================================================

-- The invoking process environment, inspected once at session start during
-- credential resolution (see the Environment entity for the detection
-- sources and CredentialSelection for how the result shapes each SDK
-- subprocess env).
given {
    environment: Environment
}


-- =============================================================
-- Configuration
-- =============================================================

config {
    workspace_cleanup_age: Duration = 7.days
    oracle_context_entry_limit: Integer = 20
    default_session_timeout: Duration = 300.seconds
    default_max_agent_turns: Integer = 50
    default_max_user_follow_ups: Integer = 0
    default_agent_model: String = "claude-haiku-4-5"
    default_oracle_model: String = "claude-haiku-4-5"
    workspace_dir_prefix: String = "scuttlerun-project-"
}


-- =============================================================
-- Enumerations
-- =============================================================

-- The operator's credential preference, set by --auth (default auto when
-- the flag is omitted). api_key corresponds to the --auth api-key CLI token.
enum AuthMode {
    auto                          -- prefer the subscription when it is
                                  -- detected alongside API credentials, else
                                  -- forward the environment unchanged
  | subscription                  -- force the Claude subscription; withhold
                                  -- API-key credentials from the subprocess
  | api_key                       -- force ANTHROPIC_API_KEY; requires it to be set
}

-- How scuttlerun shapes an SDK subprocess environment, and hence which
-- credential that subprocess authenticates with. The Claude Code runtime the
-- Agent SDK spawns prefers ANTHROPIC_API_KEY over stored subscription OAuth,
-- so scuttlerun selects a credential by withholding the ones it does not want.
--
-- Every selection additionally applies the same OAuth-token shaping: an
-- inherited CLAUDE_CODE_OAUTH_TOKEN is stripped (the runtime would let it
-- override a /login credential), and a non-blank CLAUDE_SDK_OAUTH_TOKEN is
-- mapped onto CLAUDE_CODE_OAUTH_TOKEN — the only name the runtime reads — so
-- an explicitly provided token wins over /login credentials.
enum CredentialSelection {
    subscription                  -- API-key variables (ANTHROPIC_API_KEY,
                                  -- ANTHROPIC_AUTH_TOKEN) withheld, so the
                                  -- subscription is used
  | api_key                       -- both OAuth-token variables withheld, the
                                  -- API key retained, so the API key is used
  | passthrough                   -- environment forwarded unchanged, apart
                                  -- from the pre-existing CLAUDECODE unset
                                  -- and the OAuth-token shaping above
}


-- =============================================================
-- External entities (caller inputs and integrations)
-- =============================================================

-- Caller-supplied configuration shape. Value type: no identity, no
-- lifecycle, immutable for the duration of a session.
value SessionInput {
    prompt: String
    agent_model: String
    oracle_model: String
    persona: String?
    max_agent_turns: Integer
    max_user_follow_ups: Integer
    max_budget_usd: Decimal?
    timeout: Duration
    permission_mode: `default` | `acceptEdits` | `bypassPermissions` | `plan` | `dontAsk`
    tools: List<String>
    disallowed_tools: List<String>?
    effort: low | medium | high | xhigh | max
    project: ProjectTemplate?
    sandbox: Sandbox
    auth: AuthMode

    @guidance
        -- prompt is forwarded verbatim to the Agent SDK as the initial
        -- user message; scuttlerun performs no slash-command expansion.
        -- A slash-command prompt (e.g. /plugin:skill ...) only resolves
        -- when the defining skill/plugin is loaded into the session (via
        -- project.skills, project.plugins, or sdk.plugins), which
        -- registers it among the session's available slash commands. When
        -- the prompt begins with a slash command that is not so
        -- registered, the runner emits a stderr warning at session start
        -- (the agent would otherwise receive it as literal text and
        -- typically run zero turns); the session still proceeds.
        --
        -- agent_model is supplied via the top-level YAML field model
        -- and defaults to config.default_agent_model when omitted.
        -- oracle_model is supplied via the YAML field user.oracle_model
        -- (under the top-level user section) and defaults to
        -- config.default_oracle_model when omitted.
        --
        -- max_user_follow_ups is supplied via the YAML field
        -- user.max_turns (under the top-level user section). The field
        -- on SessionInput represents the resolved value the runner
        -- enforces against synthetic_user.user_turn_count.
        --
        -- tools is the resolved post-merge available-tools list the
        -- runner hands to the Agent SDK — the base set of tools made
        -- available to the agent. The caller may supply two layers of
        -- tool input — a base list (YAML field tools) and an
        -- additional list (YAML field additional_tools) — and the
        -- resolved tools field represents both layers concatenated,
        -- with the additional entries appended after the base entries
        -- and duplicates removed on a first-wins basis. The list shape
        -- (rather than a set) is load-bearing: ordering is preserved
        -- so that downstream consumers see a deterministic sequence,
        -- and first-wins dedup means an additional entry that repeats
        -- a base entry is a no-op rather than a reorder.
        --
        -- timeout is supplied via the top-level YAML field timeout
        -- (in seconds) and defaults to config.default_session_timeout
        -- (300 seconds) when omitted; like other config values it flows
        -- through the base+scenario merge, so a scenario may override a
        -- base timeout. The --timeout CLI flag, when supplied, overrides
        -- the merged config value. The field on SessionInput represents
        -- the resolved value the runner enforces against
        -- session.started_at: CLI flag if passed, else the merged config
        -- value, else config.default_session_timeout.
        --
        -- effort is passed through to the Agent SDK as a reasoning
        -- effort knob. Default value handling lives in CLI/config and
        -- is out of spec scope.
        --
        -- auth is the resolved credential preference (AuthMode). It is
        -- supplied via the top-level YAML field auth and the --auth CLI
        -- flag (the flag overrides the merged config value, like timeout),
        -- defaulting to auto when omitted. An invalid --auth value is a
        -- configuration error (exit 1) whose message names the valid modes.
        -- The resolved value is echoed in the --dry-run summary. How auth
        -- shapes each SDK subprocess env is specified on
        -- Session.credential_selection and the AgentSdkBoundary /
        -- OracleSdkBoundary surfaces.
}

value ProjectTemplate {
    claude_md: String?
    skills: List<String>
    plugins: List<String>
    settings: Map<String, Any>?
    files: Map<String, String>?
    claude_dir: String?
    git_init: Boolean

    @guidance
        -- plugins is the preferred caller surface for loading local
        -- plugins into the agent session. Each entry is a path string
        -- to a plugin directory (the directory containing
        -- .claude-plugin/plugin.json).
        --
        -- At session-start, each project.plugins entry is translated
        -- into a raw SDK plugin spec of shape (type: local, path: P)
        -- where P is the resolved absolute path. The resolved entries
        -- are concatenated with any caller-supplied raw sdk.plugins
        -- entries (project entries first), and duplicates are removed
        -- by resolved path on a first-wins basis. The order shape
        -- mirrors the tools / additional_tools precedence model
        -- documented on SessionInput.
        --
        -- Unlike project.skills, project.plugins does NOT scaffold
        -- workspace symlinks under .claude/plugins/ and does NOT read
        -- the plugin manifest at scaffold time. The translation is
        -- purely a shape-level rewrite of the caller's SessionInput
        -- before the Agent SDK is invoked. Per-plugin validation
        -- (whether the path exists, whether it is a valid plugin) is
        -- delegated to the Agent SDK.
        --
        -- claude_dir seeds the agent's Claude Code config directory
        -- (the directory Claude Code reads as CLAUDE_CONFIG_DIR). It is
        -- a path string, resolved like a skill path (~ and paths
        -- relative to the config file's directory). It must resolve to
        -- an existing directory; otherwise the session is rejected as a
        -- configuration error before any workspace is created. See
        -- WorkspaceSeedsClaudeDir and SeededClaudeDirIsACopy.
}

value Sandbox {
    enabled: Boolean
    network: SandboxNetwork
    filesystem: SandboxFilesystem

    @guidance
        -- sandbox.enabled defaults to true. Callers must explicitly set
        -- enabled=false to opt out; the default-on posture is
        -- load-bearing for the HOME redirection and env-filter
        -- behaviour described on Workspace.
        --
        -- Network access is governed by the explicit allowlist on
        -- SandboxNetwork; an empty allowed_domains list means no
        -- domains are reachable. There is no global on/off network
        -- toggle separate from sandbox.enabled.
        --
        -- Filesystem access for the commands the agent runs through the
        -- Bash tool is governed by separate read and write
        -- denylists plus a write allowlist; there is no general read
        -- allowlist (read defaults to allowed except as denied). The
        -- read denylist defaults to common credential paths
        -- (~/.ssh, ~/.aws, ~/.config/gcloud) and the write denylist
        -- defaults to .env; these defaults apply only when the caller
        -- supplies no list of their own. Supplying a deny_read or
        -- deny_write list replaces the default in full, so callers
        -- who customise these lists must re-include any default
        -- entries they want to retain. A leading ~ in any of the
        -- three lists names the operator's home directory, not the
        -- redirected HOME the sandboxed commands see (Workspace): the
        -- runner expands it before handing the lists to the Agent SDK,
        -- which would otherwise resolve it against the redirected HOME
        -- and leave the credential defaults pointing inside the
        -- workspace. The workspace path and /tmp are unconditionally
        -- writable in addition to whatever allow_write lists; callers
        -- do not need to (and cannot) revoke these two roots. The file tools are outside the OS
        -- sandbox and these lists do not confine them; see Workspace.
        --
        -- Bash auto-allow under the sandbox is not caller-configurable:
        -- when the sandbox is enabled, the runner always passes
        -- autoAllowBashIfSandboxed=true and allowUnsandboxedCommands=
        -- false to the Agent SDK.
}

value SandboxNetwork {
    allowed_domains: List<String>
    allow_local_binding: Boolean
}

value SandboxFilesystem {
    deny_read: List<String>
    allow_write: List<String>
    deny_write: List<String>
}

-- The Agent SDK process scuttlerun drives for the agent session.
-- Code-to-code boundary.
external entity AgentSdkClient {}

-- The Agent SDK process scuttlerun drives for a one-shot synthetic-user
-- oracle query (no tools, structured output). The oracle runs through
-- the same Claude Agent SDK as the agent session — not the raw Anthropic
-- Messages API — so both authenticate through the same Claude Code
-- credential surface. Code-to-code boundary.
external entity OracleSdkClient {}

-- The invoking process environment scuttlerun inspects once at session start
-- to decide which credential each SDK subprocess authenticates with.
-- Governed by: the OS shell environment, filesystem, and (on macOS) Keychain.
--
-- Subscription-credential detection is best-effort, checked in order, and
-- short-circuits on the first hit:
--   1. CLAUDE_SDK_OAUTH_TOKEN set to a non-blank value;
--   2. a Claude Code credentials file at $CLAUDE_CONFIG_DIR/.credentials.json
--      (or ~/.claude/.credentials.json when CLAUDE_CONFIG_DIR is unset) that
--      parses as JSON and carries a claudeAiOauth key — an unreadable or
--      unparseable file counts as absent;
--   3. on macOS only, a Keychain generic password with service name
--      "Claude Code-credentials" — a failed lookup counts as absent.
--
-- CLAUDE_CODE_OAUTH_TOKEN is never a detection source: scuttlerun always
-- strips it from subprocess environments (the Claude Code runtime would let
-- it override a /login credential), so its presence proves nothing usable.
--
-- Detection runs in two scopes because the agent runs under different HOMEs.
-- subscription_present includes all three sources (the oracle and the
-- non-sandboxed agent run under the real HOME). sandbox_subscription_present
-- excludes source 3: the sandboxed agent runs under a redirected HOME that
-- cannot reach the Keychain, so a Keychain-only login must not count there
-- (it would otherwise leave the sandbox unauthenticated).
external entity Environment {
    has_api_key: Boolean          -- ANTHROPIC_API_KEY set and non-blank
    has_api_credentials: Boolean  -- ANTHROPIC_API_KEY or ANTHROPIC_AUTH_TOKEN set
    has_claude_code_oauth_token: Boolean -- CLAUDE_CODE_OAUTH_TOKEN set and
                                         -- non-blank (always stripped, never
                                         -- used as a credential)
    subscription_present: Boolean         -- detection incl. Keychain
    sandbox_subscription_present: Boolean -- detection excl. Keychain
}

-- The shell/script invoking scuttlerun.
external entity Caller {}


-- =============================================================
-- Domain entities
-- =============================================================

entity Session {
    input: SessionInput
    workspace: Workspace
    started_at: Timestamp
    sdk_session_id: String?

    -- Credential preference resolved once at session start, before any
    -- session work, from input.auth and the detected environment. Two scopes
    -- exist because the agent runs under different HOMEs: credential_selection
    -- governs the oracle and the non-sandboxed agent (real HOME,
    -- Keychain-inclusive detection); sandbox_credential_selection governs the
    -- sandboxed agent (redirected HOME that cannot reach the macOS Keychain).
    -- They differ only in auto mode when the sole subscription credential is a
    -- macOS Keychain login: the parent scope selects subscription while the
    -- sandbox scope keeps the API key, so the sandbox is not left
    -- unauthenticated.
    credential_selection: CredentialSelection
    sandbox_credential_selection: CredentialSelection

    status: pending | running | completed_success
          | exhausted_turns | exhausted_budget | failed | timed_out
          | interrupted

    turn_count: Integer
    tool_call_count: Integer
    agent_cost: Decimal
    oracle_cost: Decimal
    cost_incomplete: Boolean
    transcript_incomplete: Boolean
    timed_out_observed: Boolean

    transitions status {
        pending -> running
        pending -> failed
        running -> completed_success
        running -> exhausted_turns
        running -> exhausted_budget
        running -> failed
        running -> timed_out
        running -> interrupted
        terminal: completed_success, exhausted_turns, exhausted_budget, failed, timed_out, interrupted
    }

    is_terminated: status in {completed_success, exhausted_turns,
                              exhausted_budget, failed, timed_out,
                              interrupted}
    total_cost: agent_cost + oracle_cost

    transcript: Transcript with session = this
    synthetic_user: SyntheticUser? with session = this

    @guidance
        -- status is a logical/observable property of the session, not a
        -- persisted field. Its terminal value is reflected in the OS exit
        -- code (see mapping below) rather than written to storage.
        --
        -- Exit code mapping (emitted to the OS on termination):
        --   completed_success → 0
        --   failed            → 2 (runtime error)
        --   exhausted_budget  → 5
        --   timed_out         → 6
        --   exhausted_turns   → 7
        --   interrupted       → 130 (SIGINT/SIGTERM)
        -- Code 1 (configuration error) is emitted before a Session exists
        -- and so is not represented here. Codes 3 and 4 belong to upstream
        -- tooling in the scuttlerun/pincenez/craboodle taxonomy and are
        -- never produced by scuttlerun.
}

-- The temporary directory that becomes the agent's working directory.
-- Always created, even when no template is supplied.
entity Workspace {
    path: String
    created_at: Timestamp
    last_modified: Timestamp

    @guidance
        -- When the sandbox is enabled, HOME is redirected to
        -- <workspace>/.home so that what the agent process locates through
        -- HOME — its Claude Code config directory, tool caches, ~ in shell
        -- commands — resolves inside the workspace rather than the
        -- operator's home directory. This applies regardless of whether the
        -- workspace was scaffolded from a project template. The redirection
        -- changes where HOME points; it does not by itself confine file
        -- access (see "What confines the agent's file access" below).
        --
        -- A single carve-out exists for subscription authentication: when
        -- the sandbox's auth-shaped view of the environment presents no
        -- ANTHROPIC_API_KEY and the operator's real-home credentials file
        -- exists, that one file (~/.claude/.credentials.json) is exposed
        -- inside the sandbox via a symlink at
        -- <workspace>/.home/.claude/.credentials.json. Nothing else under
        -- the operator's ~/.claude/ is linked in, so Claude Code does not
        -- discover the operator's skills, plugins, commands, agents,
        -- settings or prior session history through its config directory.
        -- That is a statement about discovery, not reachability: see "What
        -- confines the agent's file access" below. The symlink and the
        -- warning below both evaluate the auth-shaped view (see
        -- Session.sandbox_credential_selection), not the raw parent env, so a
        -- subscription-preferring mode links the credentials file even when
        -- ANTHROPIC_API_KEY is set in the parent process. The carve-out is
        -- silently skipped when the auth-shaped view still carries an API key
        -- (api-key mode, or auto with no subscription detected in the sandbox
        -- scope) or when no credentials file exists.
        --
        -- When the sandbox is enabled and that carve-out links nothing
        -- — the auth-shaped view carries no ANTHROPIC_API_KEY, no
        -- CLAUDE_SDK_OAUTH_TOKEN, and there is no credentials file to
        -- expose — the agent subprocess has no credential it can reach (a
        -- macOS subscription `claude /login` stores its credential in the
        -- Keychain, which the sandbox cannot see). The runner emits a stderr
        -- warning at session start so this surfaces as actionable guidance
        -- rather than an opaque downstream authentication failure. The
        -- diagnostic is scoped to sandboxed sessions: without the sandbox the
        -- subprocess inherits the real HOME and can read the Keychain
        -- directly, so no such determination is made.
        --
        -- What confines the agent's file access. The OS sandbox governs
        -- the commands the agent runs through the Bash tool: the
        -- filesystem lists on Sandbox bound their reads and writes. The
        -- file tools (Read, Write, Edit, NotebookEdit, Glob, Grep) run in
        -- the agent process itself, outside the OS sandbox: the workspace,
        -- /tmp and allow_write do not bound their writes, and deny_read
        -- does not stop their reads. Under the default bypassPermissions,
        -- and under `default` or `acceptEdits` (where the canUseTool
        -- callback allows every tool call, answering AskUserQuestion
        -- through the oracle), a file tool can read or write any path the
        -- operator's user can, by absolute path, the operator's real home
        -- and ~/.claude/ included, and a workspace entry that is a symlink
        -- leads it to the link's target. (`dontAsk` refuses calls that are
        -- not pre-approved, and `plan` withholds tool execution.)
        --   - each project.skills entry is a symlink to the operator's
        --     source skill directory, so a Write or Edit under
        --     <workspace>/.claude/skills/<name>/ modifies the operator's
        --     source files;
        --   - the credentials carve-out above is a symlink to the
        --     operator's real credentials file;
        --   - project.plugins and sdk.plugins load from their source
        --     directories in place, with no workspace copy;
        --   - project.claude_dir is copied, so writes into the seeded
        --     config directory stay in the workspace.
        -- scuttlerun leaves file-tool confinement to the caller. Claude
        -- Code's permissions.blockWritesOutsideWorkingDirectories setting
        -- refuses file-tool writes (Write, Edit, NotebookEdit) outside the
        -- working directories in every permission mode, and judges a path
        -- that resolves through a symlink by where the link leads, so the
        -- skill and credentials symlinks are refused too. Files Claude
        -- Code keeps for the session are exempt: its plan files,
        -- scratchpad, background-job folder and the project's auto-memory.
        -- The plan files and auto-memory live in the agent's Claude config
        -- directory, which is inside the workspace (<workspace>/.home/.claude)
        -- when the sandbox is enabled or project.claude_dir is set, and is
        -- the operator's real ~/.claude/ otherwise; the scratchpad lives
        -- under the system temp directory. A caller opts in
        -- through project.settings, which lands in
        -- <workspace>/.claude/settings.json and is read whenever
        -- setting_sources includes `project` (the default when a project
        -- template is present). The same setting also refuses file-tool
        -- writes to Claude Code settings files inside the workspace, which
        -- is why it is not on by default: a session that evaluates how the
        -- agent edits its own configuration would have those edits
        -- refused. It also withdraws EnterWorktree and ExitWorktree from
        -- the tools on offer. It does not limit shell commands, MCP tools,
        -- the programs hooks run or the memory tools, and it does not
        -- confine reads.
        --
        -- When session.input.sandbox.enabled, the agent subprocess
        -- receives only an allowlisted set of environment variables
        -- (plus any user-supplied sdk.env overrides applied on top).
        -- The behavioural shape is: env is filtered, not inherited.
        -- The contents of the allowlist are a code-level concern and
        -- are not enumerated here.
        --
        -- last_modified reflects the filesystem mtime of the workspace
        -- directory, not an in-memory write-tracking value. It is
        -- updated by the operating system in response to file activity
        -- inside the workspace and is read back from the filesystem
        -- when StaleWorkspaceCleanup evaluates whether a workspace is
        -- old enough to reclaim.
}

-- The LLM-driven simulation of the human user.
entity SyntheticUser {
    session: Session
    persona: String?
    user_turn_count: Integer

    has_remaining_follow_ups:
        user_turn_count < session.input.max_user_follow_ups

    @guidance
        -- The synthetic user only forwards the most recent
        -- config.oracle_context_entry_limit user/assistant entries of
        -- the conversation buffer to the oracle. Earlier entries are
        -- dropped. Tool uses, tool results and thinking blocks are
        -- stripped before entries enter the conversation buffer.
}

-- An entry in the synthetic user's conversation buffer. A marker
-- entity recording role and ordering. The actual text payload is
-- observable through the transcript and the SDK session JSONL rather
-- than persisted on the entity model; the structural assertion here
-- is that only entries whose role is in {user, assistant} ever enter
-- the buffer (see OnlyTextReachesOracleContext).
entity ConversationEntry {
    synthetic_user: SyntheticUser
    sequence: Integer
    role: user | assistant
}

-- A clarifying question request from the agent (AskUserQuestion tool).
-- A marker entity recording that a request was received and routed
-- to the oracle. Question payload, oracle answers, reasoning and
-- token usage are observable through the transcript and footer
-- rather than persisted on the entity model.
entity ClarifyingQuestionRequest {
    session: Session
}

-- A turn-policy decision about whether to send a follow-up. A marker
-- entity recording that the policy was evaluated for a session. The
-- decision (continue or end), follow-up message, and oracle reasoning
-- are observable through the transcript's oracle_turn entry rather
-- than persisted on the entity model.
entity TurnEvaluation {
    session: Session
}

-- Streamed YAML output to stdout. Observable while the session runs.
entity Transcript {
    session: Session
    entries: List<TranscriptEntry> with transcript = this
    finalized: Boolean
}

entity TranscriptEntry {
    transcript: Transcript
    sequence: Integer
    kind: user_message | assistant_text | thinking
        | tool_call | oracle_ask | oracle_turn | oracle_error
}


-- =============================================================
-- Rules: Session lifecycle
-- =============================================================

rule SessionStarts {
    when: SessionRequested(caller, input, started_at)

    -- Credential preference is resolved once here, before any session work.
    -- api-key mode requires ANTHROPIC_API_KEY; without it the run is a
    -- configuration error (exit 1) and no Session is created.
    requires: input.auth = api_key implies environment.has_api_key

    -- A CLAUDE_CODE_OAUTH_TOKEN that is the only credential available is a
    -- configuration error (exit 1) naming CLAUDE_SDK_OAUTH_TOKEN: scuttlerun
    -- strips that variable, so the run would otherwise reach the SDK
    -- unauthenticated and fail opaquely.
    requires:
        environment.has_claude_code_oauth_token implies
            (environment.has_api_credentials or environment.subscription_present)

    -- Parent-scope selection: governs the oracle and the non-sandboxed agent
    -- (real HOME, Keychain-inclusive detection).
    let credential_selection =
        if input.auth = api_key: api_key
        else if input.auth = subscription: subscription
        else if environment.has_api_credentials and environment.subscription_present: subscription
        else: passthrough

    -- Sandbox-scope selection: governs the sandboxed agent (redirected HOME,
    -- Keychain-exclusive detection), so a Keychain-only login does not
    -- withhold the API key from the sandbox.
    let sandbox_credential_selection =
        if input.auth = api_key: api_key
        else if input.auth = subscription: subscription
        else if environment.has_api_credentials and environment.sandbox_subscription_present: subscription
        else: passthrough

    -- Best-effort cleanup of stale workspaces from prior runs.
    -- Failures are silently ignored; this is not on the critical path.
    ensures: StaleWorkspaceCleanup(config.workspace_cleanup_age)

    ensures: Workspace.created(
        created_at: started_at,
        last_modified: started_at
    )
    ensures: Session.created(
        input: input,
        started_at: started_at,
        status: pending,
        credential_selection: credential_selection,
        sandbox_credential_selection: sandbox_credential_selection,
        turn_count: 0,
        tool_call_count: 0,
        agent_cost: 0,
        oracle_cost: 0,
        cost_incomplete: false,
        transcript_incomplete: false,
        timed_out_observed: false
    )

    @guidance
        -- StaleWorkspaceCleanup is fire-and-forget: it is dispatched
        -- when the session starts but is not sequenced before the new
        -- Workspace is created. The two ensures may complete in either
        -- order, and the cleanup's success or failure does not block
        -- session startup. The order shown here is logical, not
        -- temporal.
        --
        -- Credential resolution precedes every ensures here: it runs before
        -- the stale-workspace cleanup, project scaffolding and any transcript
        -- output. The api-key-without-key configuration error and an invalid
        -- --auth value are both raised before a Session exists (exit 1),
        -- consistent with the exit-code mapping below. Resolution never
        -- mutates the parent process env; it only shapes the per-subprocess
        -- env described on the SDK surfaces.
}

rule SessionScaffoldsSkills {
    when: SessionRequested(caller, input, started_at)

    requires: input.project != null

    for skill_path in input.project.skills:
        for workspace in Workspaces where workspace.created_at = started_at:
            ensures: SkillReferenced(input.project, skill_path, workspace)

    @guidance
        -- Each skill path declared on the project template is announced
        -- to the workspace just created for this session, kicking off
        -- scaffold-time validation in WorkspaceScaffoldsSkill.
}

rule SessionBecomesRunning {
    when: AgentInitialized(client, session)

    requires: session.status = pending

    ensures: session.status = running
    ensures: SyntheticUser.created(
        session: session,
        persona: session.input.persona,
        user_turn_count: 0
    )
    ensures: TranscriptEntry.created(
        transcript: session.transcript,
        kind: user_message
    )
    -- The initial prompt enters the synthetic user's conversation
    -- buffer so the oracle has context on the very first follow-up
    -- or clarifying question. Subsequent user entries are added by
    -- TurnPolicyContinues.
    ensures: ConversationEntry.created(
        synthetic_user: session.synthetic_user,
        role: user
    )

    @guidance
        -- The Agent SDK emits an init message with a session_id at the
        -- start of each query turn. scuttlerun captures the first one
        -- and uses it to identify the SDK session file.
}

rule SessionFinalises {
    when: session: Session.is_terminated

    ensures: session.transcript.finalized = true
    ensures: AgentSdkClosed(session)

    @guidance
        -- Fires once when the session enters any terminal state. The
        -- workspace is preserved on every termination path; reclamation
        -- happens on the next session start via StaleWorkspaceCleanup.
        -- The agent SDK child process is closed via query.close().
}


-- =============================================================
-- Rules: AskUserQuestion handling
-- =============================================================

rule SyntheticUserAnswersClarifyingQuestion {
    when: AgentAsksClarifyingQuestion(client, session)

    requires: session.status = running
    requires: exists session.synthetic_user

    ensures: ClarifyingQuestionRequest.created(session: session)
    ensures: TranscriptEntry.created(
        transcript: session.transcript,
        kind: oracle_ask
    )
    ensures: AgentReceivesAnswers(session)

    @guidance
        -- AskUserQuestion is only intercepted when "AskUserQuestion" is in
        -- session.input.tools. If absent, the agent has no way to call the
        -- tool and the synthetic user never engages.
        --
        -- The oracle is consulted with: the persona, the most recent
        -- conversation pairs (text only), and the questions. It returns
        -- an answer per question (option label or free text) plus
        -- reasoning. Tool uses, tool results and thinking blocks never
        -- appear in oracle prompts.
        --
        -- The oracle's call is retried with bounded exponential backoff
        -- before the session is terminated as a runtime error. Both a
        -- transport failure and a malformed answer set (an answer count that
        -- does not match the question count) are retryable: on a count
        -- mismatch the oracle is re-consulted with corrective feedback
        -- stating the expected count, and the session is terminated as a
        -- runtime error only if the mismatch persists across every attempt.
        --
        -- The oracle is instructed to return exactly one answer per question
        -- regardless of how many options a question carries (never one
        -- answer per option), and to encode a multi-select answer as a
        -- single entry listing the chosen labels.
        --
        -- Answers are associated to the input questions positionally (the
        -- i-th oracle answer pairs with the i-th input question) and keyed
        -- by the input question's exact text, so the agent's answer lookup
        -- resolves regardless of how the oracle echoes the question text.
}


-- =============================================================
-- Rules: Reactive turn policy
-- =============================================================

rule AgentTurnSucceeds {
    when: AgentTurnCompleted(client, session, subtype, terminal_reason, startup_failure_reason, agent_cost_to_date, num_turns_to_date)

    requires: session.status = running
    requires: subtype = success

    ensures: session.agent_cost = agent_cost_to_date
    ensures: session.turn_count = num_turns_to_date
    ensures: TurnPolicyConsultation(session)

    @guidance
        -- Turn-policy consultation is unconditional after every
        -- successful agent turn. Both short-circuits — the cap=0
        -- single-turn case and the cap-reached case — live in the
        -- turn-policy machinery (TurnPolicyCapped, whose guard
        -- not has_remaining_follow_ups holds when max_user_follow_ups
        -- is zero or already consumed) and end the session without
        -- invoking the oracle. This mirrors the runner's control
        -- flow, which always calls decideTurn() after a successful
        -- agent turn and lets decideTurn() decide whether to
        -- contact the oracle.
        --
        -- num_turns_to_date is the SDK-reported cumulative count of
        -- agent turns completed in this session up to and including
        -- this result. scuttlerun mirrors the SDK's count rather
        -- than maintaining an independent counter, matching the
        -- snapshot idiom used for agent_cost_to_date.
}

rule TurnPolicyCapped {
    when: TurnPolicyConsultation(session)

    requires: session.status = running
    requires: not session.synthetic_user.has_remaining_follow_ups

    -- Short-circuit: the cap has been reached, so the turn policy
    -- ends the session without contacting the oracle. The decision
    -- still surfaces as a TurnPolicyDecided event so that downstream
    -- handling (TurnPolicyEnds) is uniform.
    ensures: TurnPolicyDecided(session, end, null, null)
}

rule TurnPolicyConsultsOracle {
    when: TurnPolicyConsultation(session)

    requires: session.status = running
    requires: session.synthetic_user.has_remaining_follow_ups

    -- The oracle is contacted; its decision arrives later as
    -- TurnPolicyDecided and is handled by TurnPolicyContinues or
    -- TurnPolicyEnds.
    ensures: OracleConsultedForTurnPolicy(session)
}

rule TurnPolicyContinues {
    when: TurnPolicyDecided(session, decision, message, reasoning)

    requires: session.status = running
    requires: decision = continue
    requires: session.synthetic_user.has_remaining_follow_ups

    let synthetic = session.synthetic_user

    ensures: TurnEvaluation.created(session: session)
    ensures: synthetic.user_turn_count = synthetic.user_turn_count + 1
    ensures: ConversationEntry.created(
        synthetic_user: synthetic,
        role: user
    )
    ensures: TranscriptEntry.created(
        transcript: session.transcript,
        kind: oracle_turn
    )
    ensures: TranscriptEntry.created(
        transcript: session.transcript,
        kind: user_message
    )
    ensures: AgentReceivesFollowUp(session, message)
}

rule TurnPolicyEndsByOracle {
    when: TurnPolicyDecided(session, decision, message, reasoning)

    requires: session.status = running
    requires: session.timed_out_observed = false
    requires: decision = end
    requires: reasoning != null

    ensures: TurnEvaluation.created(session: session)
    ensures: TranscriptEntry.created(
        transcript: session.transcript,
        kind: oracle_turn
    )
    ensures: session.status = completed_success
}

rule TurnPolicyEndsByCap {
    when: TurnPolicyDecided(session, decision, message, reasoning)

    requires: session.status = running
    requires: session.timed_out_observed = false
    requires: decision = end
    requires: reasoning = null

    -- Cap-driven termination: the session ends without consulting the
    -- oracle, so no oracle_turn transcript entry is emitted. The
    -- TurnEvaluation marker is still recorded for completeness.
    ensures: TurnEvaluation.created(session: session)
    ensures: session.status = completed_success
}

rule AgentTurnExhaustsTurns {
    when: AgentTurnCompleted(client, session, subtype, terminal_reason, startup_failure_reason, agent_cost_to_date, num_turns_to_date)

    requires: session.status = running
    requires: session.timed_out_observed = false
    requires: subtype = error_max_turns

    ensures: session.agent_cost = agent_cost_to_date
    ensures: session.turn_count = num_turns_to_date
    ensures: session.status = exhausted_turns
}

rule AgentTurnHitsTurnCapDuringExecution {
    when: AgentTurnCompleted(client, session, subtype, terminal_reason, startup_failure_reason, agent_cost_to_date, num_turns_to_date)

    requires: session.status = running
    requires: session.timed_out_observed = false
    requires: subtype = error_during_execution
    requires: terminal_reason = max_turns

    ensures: session.agent_cost = agent_cost_to_date
    ensures: session.turn_count = num_turns_to_date
    ensures: session.status = exhausted_turns

    @guidance
        -- The turn cap can be reached mid-execution: the SDK accepts and
        -- processes a tool/skill call as the Nth tool use, then cannot
        -- start the next model turn. The result subtype is
        -- error_during_execution (not error_max_turns), but the SDK
        -- attributes the terminal cause via terminal_reason = max_turns.
        -- scuttlerun keys on terminal_reason to map this to
        -- exhausted_turns (exit 7) rather than a runtime failure (exit
        -- 2), so the same logical condition — the turn cap — yields the
        -- same exit code regardless of where in the tool-call lifecycle
        -- it fired. Disjoint from AgentTurnFailsAtRuntime, which carries
        -- the complementary `terminal_reason != max_turns` guard.
}

rule AgentTurnExhaustsBudget {
    when: AgentTurnCompleted(client, session, subtype, terminal_reason, startup_failure_reason, agent_cost_to_date, num_turns_to_date)

    requires: session.status = running
    requires: session.timed_out_observed = false
    requires: subtype = error_max_budget_usd

    ensures: session.agent_cost = agent_cost_to_date
    ensures: session.turn_count = num_turns_to_date
    ensures: session.status = exhausted_budget
}

rule AgentTurnFailsAtRuntime {
    when: AgentTurnCompleted(client, session, subtype, terminal_reason, startup_failure_reason, agent_cost_to_date, num_turns_to_date)

    requires: session.status in {pending, running}
    requires: session.timed_out_observed = false
    requires: subtype = error_during_execution
    requires: terminal_reason != max_turns

    ensures: session.agent_cost = agent_cost_to_date
    ensures: session.turn_count = num_turns_to_date
    ensures: session.status = failed

    @guidance
        -- An error_during_execution result is a genuine runtime failure
        -- only when its terminal_reason is not the turn cap; the
        -- `terminal_reason != max_turns` guard (which an absent /
        -- undefined terminal_reason also satisfies) keeps this rule
        -- disjoint from AgentTurnHitsTurnCapDuringExecution, which claims
        -- the mid-execution turn-cap case for exhausted_turns instead.
        --
        -- When the result message carries SDK error detail (the
        -- `errors` string array on the error result), the runner writes
        -- a single `[scuttlerun] <joined errors>` line to stderr as a
        -- diagnostic annotation paired with the runtime-error exit code,
        -- mirroring the timeout diagnostic in `SessionTimesOut`. The
        -- line is informational and downstream tools should not parse
        -- it; an empty or absent `errors` array emits nothing. This is
        -- what makes a runtime failure observable instead of surfacing
        -- only as a bare exit code 2.
        --
        -- The session may still be pending: when Claude Code refuses to
        -- start, the SDK writes a zeroed error_during_execution result
        -- carrying `startup_failure_reason`, possibly before any init
        -- message. That result fails the session directly (pending ->
        -- failed) with the same exit code and diagnostic line; no
        -- preamble is written because no session id was announced.
}

rule StartupFailureSuggestsSandboxFix {
    when: AgentTurnCompleted(client, session, subtype, terminal_reason, startup_failure_reason, agent_cost_to_date, num_turns_to_date)

    requires: subtype = error_during_execution
    requires: startup_failure_reason = sandbox_required_unavailable

    ensures: SandboxFixSuggested(session)

    @guidance
        -- The sandbox is enabled by default (Sandbox) and scuttlerun does
        -- not relax the Agent SDK's requirement that an enabled sandbox
        -- actually run, so a host without the sandbox's OS dependencies
        -- fails at startup. Claude Code settings (managed, user or
        -- project, e.g. loaded via `sdk.setting_sources` or a seeded
        -- `project.claude_dir`) can impose the same requirement while
        -- scuttlerun's own sandbox is off. Alongside the SDK error line
        -- written under AgentTurnFailsAtRuntime, the runner writes one
        -- actionable `[scuttlerun] ...` line to stderr that first says to
        -- install the sandbox's OS dependencies (on Linux, bubblewrap
        -- and socat). When `sandbox.enabled` is true it then offers
        -- setting `sandbox.enabled: false` in the session config; when
        -- it is false, that switch is already off and cannot help, so
        -- the line instead attributes the requirement to Claude Code
        -- settings and says to lift it there. Like the other stderr
        -- diagnostics it is informational and not for parsing.
        --
        -- This rule does not touch `status`; AgentTurnFailsAtRuntime
        -- commits the failure and the exit code stays the runtime-error
        -- code. It requires no particular status because the result may
        -- arrive before init. Any other startup_failure_reason, or none,
        -- adds no hint.
}

rule SessionFailsFromUncaughtException {
    when: RunnerCaughtException(session)

    requires: session.status = running
    requires: session.timed_out_observed = false

    ensures: session.status = failed
    -- No result message reported the in-flight turn's cost, so the agent
    -- cost in the footer is incomplete/unknown rather than a confirmed $0.
    ensures: session.cost_incomplete = true

    @guidance
        -- Witnesses the running -> failed edge for exceptions that
        -- escape the message-processing loop without arriving as an
        -- AgentTurnCompleted result (for example, an SDK iterator
        -- failure, a writer error or any other thrown error). The
        -- agent_cost and turn_count snapshots are not updated on
        -- this path because no result message reported new values;
        -- whatever last value the AgentTurnCompleted handlers wrote
        -- is preserved. Coincident timeouts are excluded by the
        -- `timed_out_observed` guard, which keeps this rule disjoint
        -- from `SessionTimesOut`.
        --
        -- Mid-stream SDK failures are not retried and the session is
        -- not resumed by session_id: the failed terminal status is
        -- final. Retry/resume granularity is intentionally out of
        -- scope; only the oracle and StructuredOutputParse contracts
        -- carry bounded retries with backoff (see
        -- SyntheticUserAnswersClarifyingQuestion and
        -- StructuredOutputParse.SchemaConformance).
        --
        -- On this non-timeout, non-signal exception path the runner
        -- writes a single `[scuttlerun] <exception message>` line to
        -- stderr as a diagnostic annotation paired with the
        -- runtime-error exit code (same informational, do-not-parse
        -- contract as the timeout and AgentTurnFailsAtRuntime
        -- diagnostics). The timeout and signal branches keep their own
        -- handling and do not emit this line.
}

rule SessionTimeoutObserved {
    when: session: Session.started_at + session.input.timeout <= now

    requires: session.status = running
    requires: session.timed_out_observed = false

    ensures: session.timed_out_observed = true
    ensures: TimeoutObserved(session)

    @guidance
        -- Observer half of the timeout split. Fires on the temporal
        -- predicate (deadline reached while the session is still
        -- running), flips the `timed_out_observed` flag and emits the
        -- TimeoutObserved chained trigger consumed by `SessionTimesOut`.
        -- The `timed_out_observed = false` precondition is the standard
        -- temporal-trigger re-fire guard. This rule does not write
        -- `status`; the terminal transition is committed by
        -- `SessionTimesOut` from the chained trigger.
}

rule SessionTimesOut {
    when: TimeoutObserved(session)

    requires: session.status = running
    requires: session.timed_out_observed = true

    ensures: session.status = timed_out
    ensures: AgentInterrupted(session)
    -- The in-flight turn was aborted before its result, so the agent cost
    -- in the footer is incomplete/unknown rather than a confirmed $0.
    ensures: session.cost_incomplete = true

    @guidance
        -- Committer half of the timeout split. Consumes the chained
        -- TimeoutObserved trigger emitted by `SessionTimeoutObserved`,
        -- writes the terminal `status = timed_out` and signals the
        -- agent abort. On timeout scuttlerun aborts the SDK abort
        -- controller and calls queryHandle.interrupt() as a
        -- belt-and-suspenders signal. The runner also writes a single
        -- `[scuttlerun] timed out after Xs` line to stderr (where X
        -- is the configured timeout in seconds) as a diagnostic
        -- annotation paired with the `timed_out` exit code; the
        -- message is informational and downstream tools should not
        -- parse it. The transcript footer is still emitted with
        -- whatever stats accrued. The terminal status reflects the
        -- timeout regardless of whether the for-await loop unwound
        -- normally or via an exception thrown mid-iteration: the
        -- runner's catch path checks the timed-out flag and resolves
        -- to timed_out either way.
        --
        -- The observe-then-commit split exists so the analyser sees
        -- the status-writing rule as disjoint from the six other
        -- rules that transition Session.status out of running:
        -- `SessionTimesOut` requires `timed_out_observed = true`,
        -- which only `SessionTimeoutObserved` can produce, while the
        -- other six rules require `timed_out_observed = false`. The
        -- shape mirrors the runner, which sets an in-memory
        -- `timedOut` flag when the abort fires and checks it at the
        -- top of the for-await loop to resolve the terminal status.
        -- `timed_out_observed` is a spec-level field that exists to
        -- make timeout precedence visible as a value-predicate guard;
        -- it does not correspond to a persisted runtime field.
}

rule SessionInterruptedByOperator {
    when: OperatorSignalReceived(session)

    requires: session.status = running
    requires: session.timed_out_observed = false

    ensures: session.status = interrupted
    ensures: AgentInterrupted(session)
    -- The in-flight turn was aborted before its result, so the agent cost
    -- in the footer is incomplete/unknown rather than a confirmed $0.
    ensures: session.cost_incomplete = true

    @guidance
        -- The operator interrupted the running session by sending
        -- SIGINT or SIGTERM to the scuttlerun process. scuttlerun aborts
        -- the SDK abort controller and calls queryHandle.interrupt() to
        -- stop the in-flight turn, then commits the terminal status.
        -- The transcript footer is still emitted with whatever stats
        -- accrued. Coincident timeouts are excluded by the
        -- `timed_out_observed` guard, which keeps this rule disjoint
        -- from `SessionTimesOut` and from the failure paths: if the
        -- timeout observer has already fired, the session resolves to
        -- timed_out regardless of any later signal.
}


rule SessionTranscriptWritesLost {
    when: AgentSessionWritesLost(client, session, error_code, lost, transcript_session_ids)

    requires: "transcript" in lost
    requires: session.sdk_session_id = null
        or session.sdk_session_id in transcript_session_ids

    ensures: session.transcript_incomplete = true

    @guidance
        -- The Agent SDK reports, at most once and as the CLI exits (after
        -- the last result, if any), that a full disk ("ENOSPC") or an
        -- exhausted quota ("EDQUOT") kept it from saving lines of a session
        -- transcript, changes to the global Claude config, or both. `lost`
        -- names what was not saved; `transcript_session_ids` names the
        -- sessions whose transcripts lost lines. Only a loss that reaches
        -- this run's SDK session JSONL matters to scuttlerun: a loss
        -- confined to the global config, or attributed only to other
        -- sessions, is ignored. Before the init message there is no
        -- session id to match, so any transcript loss is presumed to be
        -- this run's.
        --
        -- The runner writes a single `[scuttlerun] WARNING: ...` line to
        -- stderr naming the error code and the JSONL path announced in
        -- the preamble (or the SDK session JSONL generically when no
        -- preamble was written). The line is informational and downstream
        -- tools should not parse it; the footer's `transcript_incomplete`
        -- key is the machine-readable signal.
        --
        -- This rule does not touch `status`: the results already received
        -- stand, the SDK does not change the CLI's exit status for this
        -- loss, and the exit code is unchanged (ExitCodeReflectsOutcome).
        -- The report arrives after the final result while the runner
        -- drains the message stream, so it is observed on every path that
        -- lets the stream drain; a timeout or signal stops the drain and
        -- may leave it unobserved.
}


-- =============================================================
-- Rules: Workspace lifecycle
-- =============================================================

rule StaleWorkspacesRemoved {
    when: StaleWorkspaceCleanup(older_than)

    for workspace in Workspaces
        where starts_with(workspace.path, config.workspace_dir_prefix)
        and workspace.last_modified + older_than <= now:
        ensures: not exists workspace

    @guidance
        -- Best-effort: filesystem failures (permission errors, races) are
        -- silently ignored. Never touches directories outside $TMPDIR.
        -- Never touches directories without the scuttlerun-project- prefix.
        -- Never touches directories from the current or recent sessions
        -- (mtime is the gate).
        --
        -- workspace_cleanup_age is a project-level constant defined in
        -- the config block; it is intentionally not exposed in
        -- SessionInput or via environment overrides. Per-session or
        -- per-invocation tuning is out of scope.
}

rule WorkspaceSeedsClaudeDir {
    when: SessionRequested(caller, input, started_at)

    requires: input.project != null
    requires: input.project.claude_dir != null
    requires: is_directory(input.project.claude_dir)

    for workspace in Workspaces where workspace.created_at = started_at:
        ensures: ClaudeDirSeeded(input.project.claude_dir, workspace)

    @guidance
        -- The seed directory is copied recursively to
        -- <workspace>/.home/.claude after the scaffold commit (it is not
        -- project content), and the agent subprocess env carries
        -- CLAUDE_CONFIG_DIR = <workspace>/.home/.claude in every env
        -- branch: the sandbox allowlist, an explicit sdk.env (which it
        -- overrides for this one variable, as HOME is overridden in the
        -- sandbox) and the inherited parent env. The location is the
        -- config directory the sandbox HOME redirection already implies,
        -- so the credentials carve-out on Workspace lands inside the
        -- seeded tree. The SDK session-file path reported in the
        -- transcript preamble is derived from the seeded directory when
        -- one exists.
}

rule WorkspaceScaffoldsSkill {
    when: SkillReferenced(template, skill_path, workspace)

    requires: is_directory(skill_path)
    requires: has_skill_md(skill_path)

    ensures: SkillSymlinked(skill_path, workspace)

    @guidance
        -- skill_path is one entry from project.skills (a raw path string).
        -- All skill paths are validated before any filesystem mutation
        -- occurs: each path must resolve to a directory containing a
        -- SKILL.md file. A failed skill validation rejects the entire
        -- session as a configuration error (exit 1) — no partial
        -- scaffolding remains. Skills are symlinked into
        -- <workspace>/.claude/skills/<name>/, not copied, so a file-tool
        -- write through the link reaches the source skill unless the
        -- caller confines file-tool writes (see Workspace).
}


-- =============================================================
-- Rules: Streaming events to the transcript and conversation buffer
-- =============================================================

rule AssistantTextEmitted {
    when: AgentEmitsAssistantMessage(client, session, text_blocks)

    requires: session.status = running
    requires: text_blocks.count > 0

    -- One transcript entry per text block in the assistant message.
    for block in text_blocks:
        ensures: TranscriptEntry.created(
            transcript: session.transcript,
            kind: assistant_text
        )

    -- One conversation entry per assistant message regardless of
    -- how the model split its reply into blocks. The text payload
    -- the buffer carries is the newline-joined concatenation of
    -- every text block; this pairs the assistant turn with a single
    -- user-side entry in the oracle context.
    ensures: ConversationEntry.created(
        synthetic_user: session.synthetic_user,
        role: assistant
    )
}

rule AssistantThinkingEmitted {
    when: AgentEmitsThinking(client, session, text)

    requires: session.status = running

    -- Thinking reaches the transcript but never the oracle context.
    ensures: TranscriptEntry.created(
        transcript: session.transcript,
        kind: thinking
    )
}

rule AssistantToolCallEmitted {
    when: AgentEmitsToolCall(client, session, tool_name)

    requires: session.status = running

    -- Tool calls reach the transcript but never the oracle context.
    ensures: TranscriptEntry.created(
        transcript: session.transcript,
        kind: tool_call
    )
    ensures: session.tool_call_count = session.tool_call_count + 1
}


-- =============================================================
-- Rules: Cost accumulation
-- =============================================================

rule OracleQueryTracked {
    when: OracleQueryCompleted(oracle, session, usage, query_cost)

    ensures: session.oracle_cost = session.oracle_cost + query_cost

    @guidance
        -- Fires once per oracle SDK query() that produced a result
        -- message — every attempt, not only the one whose output the
        -- oracle call finally uses. Attempts whose structured output
        -- fails schema or semantic validation and is retried, SDK
        -- error-subtype results, and every attempt of an oracle call
        -- that exhausts its retries all add their usage and cost, so
        -- oracle_cost is the total oracle spend. usage is the result
        -- message's token counts (input, output, cache-creation,
        -- cache-read), accumulated into the footer's oracle_usage;
        -- query_cost is the result message's total_cost_usd: the Agent
        -- SDK's own notional API-rate estimate for that query, the same
        -- pricing basis as agent_cost. total_cost_usd is cumulative
        -- within a query, so the query's last result message is the one
        -- counted. scuttlerun keeps no pricing table of its own, so the
        -- SDK's per-model rates and cache-write lifetimes apply to every
        -- oracle model the SDK knows.
}

rule OracleQueryCostUnknown {
    when: OracleQueryCostUnreported(oracle, session)

    ensures: session.cost_incomplete = true

    @guidance
        -- Fires for an oracle query() whose spend the SDK did not report:
        -- one that ends — by throwing or by finishing its stream — before
        -- any result message, or one whose result is an error subtype
        -- with total_cost_usd of zero. The SDK reports a query's cost only
        -- on its result message, and scuttlerun reads the query's token
        -- totals from that same message, so a query with no result adds
        -- nothing to oracle_cost or the token totals. The SDK may zero the
        -- figures on a crash or startup-error result, so a zero-cost error
        -- result is likewise indistinguishable from unreported spend; its
        -- (zero) usage and cost still accumulate via OracleQueryTracked. A
        -- successful result reporting zero cost is taken at its word.
        -- Either way the query may have spent tokens, so the session's
        -- cost is flagged incomplete rather than presenting the unknown
        -- spend as a confirmed zero. The query still counts toward
        -- oracle_usage.calls.
}


-- =============================================================
-- Invariants
-- =============================================================

invariant WorkspacePreservedAcrossOutcomes {
    -- The workspace owning a terminated session always still exists at
    -- the moment of termination. Reclamation is deferred to the next
    -- session's startup GC.
    for session in Sessions:
        session.is_terminated implies exists session.workspace
}

invariant ScaffoldedFilesStayInProject {
    -- Files declared by ProjectTemplate.files cannot escape the
    -- workspace nor target .git/. Path traversal and .git/ injection
    -- are rejected as configuration errors before any file is written.
    --
    -- escapes_workspace is a realpath-style check: the candidate path
    -- is resolved relative to the workspace root and the result must
    -- remain inside the workspace. Interior `..` segments that
    -- resolve back inside the workspace (for example
    -- `subdir/../file`) are permitted; only paths whose resolved form
    -- lies outside the workspace are rejected.
    for session in Sessions where session.input.project != null
                              and session.input.project.files != null:
        for (path, _) in session.input.project.files:
            path != ".git"
            and not starts_with(path, ".git/")
            and not escapes_workspace(path)
            and not starts_with(path, "/")
}

invariant SeededClaudeDirIsACopy {
    -- The agent's config directory is a copy of the seed, never the seed
    -- itself or a link to it. Claude Code treats its config directory as
    -- live state (session files, backups, caches), and none of that may
    -- reach the operator's source tree; concurrent sessions seeded from
    -- the same directory never observe each other's writes.
    for session in Sessions where session.input.project != null
                              and session.input.project.claude_dir != null:
        session.workspace.claude_dir = session.workspace.path + "/.home/.claude"
        and session.workspace.claude_dir != resolve(session.input.project.claude_dir)
        and not is_symlink(session.workspace.claude_dir)
}

invariant FollowUpsRespectCap {
    -- The number of follow-up messages the synthetic user yields never
    -- exceeds the configured cap. Single-turn mode (cap = 0) yields none.
    for synthetic in SyntheticUsers:
        synthetic.user_turn_count <= synthetic.session.input.max_user_follow_ups
}

invariant AgentTurnCapAtLeastOne {
    -- The agent turn cap is bounded below by one: a session must permit
    -- at least one agent turn. The user-side cap (max_user_follow_ups)
    -- has no such floor and may be zero (single-turn mode).
    for session in Sessions:
        session.input.max_agent_turns >= 1
}

invariant OnlyTextReachesOracleContext {
    -- The conversation buffer the oracle sees contains only user text and
    -- assistant text blocks. Tool uses, tool results and thinking blocks
    -- are stripped before insertion.
    for entry in ConversationEntries:
        entry.role in {user, assistant}
}

invariant SinglePersonaPerSession {
    -- The persona supplied at session start drives every oracle call for
    -- the entire session. There is no per-turn persona override and no
    -- discrimination between main-agent and subagent-origin clarifying
    -- questions: both go through the same oracle path with the same
    -- persona.
    for synthetic in SyntheticUsers:
        synthetic.persona = synthetic.session.input.persona
}

invariant CredentialSelectionMatchesMode {
    -- The resolved credential selection always agrees with the operator's
    -- auth mode. api-key mode selects the API key; subscription mode selects
    -- the subscription; and only api-key mode ever selects the API key. Both
    -- the parent scope (oracle and non-sandboxed agent) and the sandbox scope
    -- obey the same mapping — they diverge only between subscription and
    -- passthrough in auto mode, never onto api_key.
    for session in Sessions:
        (session.input.auth = api_key implies session.credential_selection = api_key)
        and (session.input.auth = subscription implies session.credential_selection = subscription)
        and (session.credential_selection = api_key implies session.input.auth = api_key)
        and (session.input.auth = api_key implies session.sandbox_credential_selection = api_key)
        and (session.input.auth = subscription implies session.sandbox_credential_selection = subscription)
        and (session.sandbox_credential_selection = api_key implies session.input.auth = api_key)
}


-- =============================================================
-- Surfaces
-- =============================================================

surface CommandLineInvocation {
    facing caller: Caller

    context session: Session

    exposes:
        session.turn_count
        session.tool_call_count
        session.total_cost
        session.cost_incomplete
        session.transcript_incomplete
        session.workspace.path
        session.transcript

    provides:
        SessionRequested(caller, session.input, session.started_at)
        OperatorSignalReceived(session)

    @guarantee Headless
        -- The CLI runs without an interactive TTY: stdin is closed for
        -- agent input, stdout streams the YAML transcript, and stderr
        -- carries diagnostics only. permission_mode defaults to
        -- `bypassPermissions` (chosen so the headless invocation does
        -- not block on a TTY-less permission prompt). When
        -- permission_mode is `bypassPermissions`, tool permission
        -- prompts are bypassed entirely; under other permission modes,
        -- the SDK may surface prompts and the operator must answer
        -- them on stdin explicitly.

    @guarantee SingleSessionPerInvocation
        -- One invocation runs exactly one session and produces exactly one
        -- transcript. Batch orchestration, grading and aggregation are
        -- explicitly out of scope.

    @guarantee ExitCodeReflectsOutcome
        -- The process exit code maps to session.status (see Session
        -- @guidance). Exit code 1 is reserved for configuration errors
        -- raised before a Session is created — including an invalid --auth
        -- value and api-key mode without a non-blank ANTHROPIC_API_KEY.

    @guarantee CredentialPreference
        -- The operator selects which credential the run authenticates with
        -- via --auth: auto (default), subscription, or api-key. auto prefers
        -- a detected subscription over API credentials; subscription forces
        -- the subscription; api-key forces ANTHROPIC_API_KEY. The flag
        -- overrides the merged config value (like --timeout). An invalid
        -- value is a configuration error (exit 1) whose message names the
        -- valid modes; api-key mode with ANTHROPIC_API_KEY unset or blank is
        -- a configuration error (exit 1) with the message "auth mode api-key
        -- requires ANTHROPIC_API_KEY to be set". A CLAUDE_CODE_OAUTH_TOKEN
        -- that is the only credential available is likewise a configuration
        -- error (exit 1) naming CLAUDE_SDK_OAUTH_TOKEN (see SessionStarts).
        -- The resolved auth value is echoed in the --dry-run summary. The
        -- auth mode does not affect cost: transcript footer costs remain
        -- the Agent SDK's notional API-rate estimates (each query's
        -- total_cost_usd) whichever credential is used, and
        -- max_budget_usd is unchanged.
}

surface StreamingTranscript {
    facing reader: Caller

    context session: Session

    exposes:
        session.sdk_session_id
        session.workspace.path
        for entry in session.transcript.entries:
            entry.sequence
            entry.kind

    @guarantee StreamingYaml
        -- Output is a single YAML document streamed as the session runs:
        -- a preamble mapping, a `conversation:` sequence with one entry
        -- per event, and a footer mapping. The preamble and the
        -- `conversation:` sequence are written when the init message
        -- announces the SDK session id; a run that ends before any init
        -- message (e.g. Claude Code refusing to start) writes the footer
        -- mapping alone. The preamble carries five
        -- keys: `session` (the SDK session id), `config` (the path or
        -- list of paths to the YAML config files supplied at
        -- invocation), `project` (the workspace path),
        -- `transcript` (the SDK session JSONL path) and `legend` (how
        -- to read the rest; see SelfDescribingTranscript). The footer
        -- always carries `turns` (count), `tool_calls` (count) and
        -- `duration_s` (seconds). Additional keys appear conditionally:
        -- `cost_usd` (Decimal: agent + oracle total) appears when the
        -- total is greater than zero; `oracle_cost_usd` (Decimal)
        -- appears when the oracle cost is greater than zero;
        -- `oracle_usage` appears when the oracle has issued at least
        -- one SDK query and is a flat mapping with `input_tokens`,
        -- `output_tokens`, `cache_creation_input_tokens`,
        -- `cache_read_input_tokens`, `calls` (SDK queries issued,
        -- retried attempts included) and `cost_usd` (oracle_cost, rounded
        -- to 4 decimal places like `oracle_cost_usd`, so the two match
        -- whenever both appear); the token counts and costs cover every
        -- attempt (see OracleQueryTracked);
        -- `cost_incomplete` (Boolean) appears only when truthy and means
        -- some spend went unreported — the session terminated before the
        -- in-flight agent turn reported a final result, or an oracle
        -- query ended without a result message or with a zero-cost error
        -- result (OracleQueryCostUnknown) — so the cost shown or omitted
        -- is incomplete/unknown rather than a confirmed $0;
        -- `transcript_incomplete` (Boolean) appears only when truthy and
        -- means the SDK session JSONL for this run (announced in the
        -- preamble when one was written) is missing lines (see
        -- SessionTranscriptWritesLost);
        -- `timed_out`
        -- (Boolean) appears only when truthy; and `files_written`,
        -- `files_edited`, `files_read` each appear only when their
        -- respective list is non-empty. Long single-line strings render
        -- in block-folded (`>`) style; multi-line strings render in
        -- block-literal (`|`) style. Lines exceeding 80 columns in the
        -- final output are wrapped — by the YAML serializer for
        -- block-folded scalars and by hard-wrapping at word boundaries
        -- for block-literal scalars. Strings without any whitespace
        -- break point are preserved verbatim even when longer than 80
        -- columns.

    @guarantee InspectableMidSession
        -- A reader joining mid-session sees the preamble plus all entries
        -- emitted so far. The footer appears only after termination.

    @guarantee FullConversationInJsonl
        -- The full native conversation (including tool uses, tool results
        -- and thinking) is preserved by the Agent SDK in a JSONL file
        -- whose path is announced in the preamble. scuttlerun does not
        -- own this file.
        --
        -- Failure case: when the SDK reports that a full disk or exhausted
        -- quota kept it from writing this session's transcript, the JSONL
        -- is missing lines. scuttlerun then sets `transcript_incomplete`
        -- in the footer and warns on stderr (SessionTranscriptWritesLost),
        -- so readers know the JSONL is not the full conversation.

    @guarantee TranscriptToolFieldContract
        -- The transcript captures tool invocations as observations, not
        -- as faithful reproductions of tool inputs. For each named tool
        -- below, the entry carries exactly the listed fields (in addition
        -- to `tool:`); all other input fields the agent supplied are
        -- intentionally dropped from the YAML transcript. The SDK JSONL
        -- (see `FullConversationInJsonl`) is the source of truth for full
        -- tool inputs. A tool entry records that the agent requested the
        -- call: tool results are not written to the transcript, so whether
        -- the call ran, failed or was blocked (by a hook, for instance)
        -- is not shown.
        --
        --   * Read, Write, Edit  → `path` (from `file_path`).
        --     Content-bearing fields (`content`, `old_string`,
        --     `new_string`) do NOT appear in the transcript. Downstream
        --     graders cannot assert on what was written or replaced from
        --     the transcript alone.
        --   * Bash               → `command`.
        --   * Glob, Grep         → `pattern`.
        --   * TodoWrite          → `todos` (full array).
        --   * TaskCreate         → `subject`, `description`.
        --   * TaskUpdate         → `task_id` (from `taskId`); `status`
        --     only when supplied.
        --   * TaskList           → no extra fields.
        --   * TaskGet            → `task_id` (from `taskId`).
        --   * Any other tool name → the full `input` mapping is emitted
        --     verbatim under an `input:` key.
        --
        -- Each transcript states this contract in its own legend
        -- (SelfDescribingTranscript), so changing the captured fields
        -- changes the legend with them; downstream graders read the
        -- legend rather than embedding a copy of this list.

    @guarantee SelfDescribingTranscript
        -- The preamble's `legend` mapping states how to read the
        -- transcript, so a reader or grader needs no copy of this spec.
        -- It has four keys: `entries` (one line per entry kind: user,
        -- assistant, thinking, tool, oracle); `tool fields` (the
        -- TranscriptToolFieldContract, one line per tool group plus
        -- `any other tool`); `not recorded` (tool results and hook
        -- activity, pointing to the SDK session JSONL named by
        -- `transcript`); and `footer` (what `cost_incomplete`,
        -- `transcript_incomplete` and `timed_out` mean). The legend is
        -- the same in every transcript, and the --dry-run summary carries
        -- it under the same key, so a consumer can read it before any
        -- session runs. The `tool fields` lines are generated from the
        -- table that selects each tool entry's fields, so the legend
        -- cannot disagree with the entries it describes. Graders
        -- interpret the legend's wording, so changing it changes this
        -- guarantee.
}

surface AgentSdkBoundary {
    facing client: AgentSdkClient

    context session: Session

    exposes:
        session.sdk_session_id
        session.workspace.path

    provides:
        AgentInitialized(client, session)
        AgentTurnCompleted(client, session, subtype, terminal_reason, startup_failure_reason, agent_cost_to_date, num_turns_to_date)
        AgentAsksClarifyingQuestion(client, session)
        AgentEmitsAssistantMessage(client, session, text_blocks)
        AgentEmitsThinking(client, session, text)
        AgentEmitsToolCall(client, session, tool_name)
        AgentSessionWritesLost(client, session, error_code, lost, transcript_session_ids)
        RunnerCaughtException(session)

    contracts:
        fulfils ToolPermissionCallback
        demands MultiTurnPromptStream
        demands SessionPersistence
        demands AbortableExecution

    @guarantee CredentialSelectionShapesSubprocessEnv
        -- The resolved credential preference shapes the agent subprocess env
        -- so the chosen credential wins (the Claude Code runtime otherwise
        -- prefers ANTHROPIC_API_KEY over stored subscription OAuth).
        -- subscription withholds the API-credential variables
        -- (ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN); api-key withholds both
        -- OAuth-token variables and keeps the key; auto withholds the
        -- API-credential variables only when both API credentials and a
        -- subscription credential are detected, else passes the env through.
        -- In every mode except api-key, a non-blank CLAUDE_SDK_OAUTH_TOKEN is
        -- mapped onto CLAUDE_CODE_OAUTH_TOKEN (the only name the runtime
        -- reads) and the inherited CLAUDE_CODE_OAUTH_TOKEN is stripped.
        -- CLAUDECODE is always unset and the parent process env is never
        -- mutated.
        --
        -- The shaping is applied at two application points. When the sandbox
        -- is enabled it is applied to the allowlist-filtered env using the
        -- sandbox-scope selection (Session.sandbox_credential_selection,
        -- Keychain-exclusive); when the sandbox is disabled it is applied to
        -- the parent env using the parent-scope selection
        -- (Session.credential_selection, Keychain-inclusive). An explicit
        -- operator-supplied sdk.env (a full env replacement) is exempt from
        -- auth shaping — the operator asked for exactly that environment.

    @guidance
        -- session.input.disallowed_tools is the deny list scuttlerun
        -- passes to the Agent SDK alongside the allow list. Under
        -- permission_mode = `bypassPermissions` the SDK skips its
        -- normal prompt-and-allow flow; disallowed_tools is the direct
        -- deny list, and Claude Code settings delivered through
        -- project.settings (permission deny rules,
        -- permissions.blockWritesOutsideWorkingDirectories; see
        -- Workspace) can also refuse calls in every mode. Under the
        -- other permission modes the deny list still applies but is
        -- layered on top of the mode's own enforcement.
}

surface OracleSdkBoundary {
    facing oracle: OracleSdkClient

    context session: Session

    provides:
        OracleQueryCompleted(oracle, session, usage, query_cost)
        OracleQueryCostUnreported(oracle, session)
        TurnPolicyDecided(session, decision, message, reasoning)

    contracts:
        demands StructuredOutputParse

    @guarantee OracleRunsThroughAgentSdk
        -- Each oracle exchange is a one-shot Claude Agent SDK query() with
        -- no tools, persistSession disabled, permissionMode
        -- bypassPermissions, the oracle system prompt plus the SDK's
        -- dynamic-boundary marker, and structured output enforced by a
        -- hand-written JSON schema. Each schema is a single top-level object
        -- (the SDK's structured-output path returns nothing and exits for
        -- top-level anyOf/oneOf, so the turn-policy union is flattened to
        -- one object with an optional message; the Zod schemas remain the
        -- validation source of truth). The oracle never calls the
        -- Anthropic Messages API directly.

    @guarantee OracleSharesCredentialSurface
        -- The oracle runs in this process (never sandboxed) under the
        -- auth-shaped parent env (Keychain-inclusive detection), so it
        -- authenticates through the same Claude Code credential surface as
        -- the agent session. A subscription-only environment works end to
        -- end: oracle features require no separate API key.
        -- Token usage and cost are both read from each query's SDK result
        -- message (see OracleQueryTracked).

    @guarantee OracleIsolatedFromHostConfiguration
        -- The oracle query loads no Claude Code configuration from the
        -- host's filesystem or the operator's Claude account: settingSources
        -- is empty (no user, project or local settings, so none of their
        -- hooks, enabled plugins, env, permissions or CLAUDE.md files),
        -- strictMcpConfig is set with no MCP servers supplied (no
        -- ~/.claude.json, .mcp.json, settings or plugin MCP servers start),
        -- and the skills filter is empty. Flag settings disable auto-memory
        -- and, for a signed-in Claude account, claude.ai MCP connectors
        -- (disableClaudeAiConnectors) and the plugins and skills synced from
        -- claude.ai (syncClaudeAiPlugins and syncClaudeAiSkills false), which
        -- settingSources does not govern because they come from the account
        -- rather than a settings file. So the operator's settings files, MCP
        -- configuration, skills, plugins and auto-memory, and the launch
        -- directory's, cannot steer the synthetic user.
        -- Two inputs are outside this guarantee. The oracle inherits the
        -- auth-shaped parent env (OracleSharesCredentialSurface), so
        -- environment variables that configure Claude Code (ANTHROPIC_*,
        -- CLAUDE_CODE_*, MAX_THINKING_TOKENS and the like) still reach it.
        -- And policy-tier (managed) settings an administrator installs still
        -- apply: the SDK reads them whatever settingSources says.
}


-- =============================================================
-- Contracts
-- =============================================================

contract ToolPermissionCallback {
    decide: (tool_name: String, input: Any) -> Any

    @invariant AskUserQuestionAnswered
        -- For tool_name = "AskUserQuestion", the result is
        -- { behavior: "allow", updatedInput: { questions, answers } }
        -- where answers come from the oracle and reflect the configured
        -- persona. If the input does not parse as a list of questions,
        -- the result is { behavior: "deny", message: <string> }.

    @invariant OtherToolsPassThrough
        -- For tool_name != "AskUserQuestion", the result is
        -- { behavior: "allow", updatedInput: input } — i.e. the caller's
        -- input is passed through unchanged. The configured permission_mode
        -- is responsible for any further enforcement; the callback itself
        -- adds no extra restriction.

    @invariant PermissionResultShapeMatchesSdkSchema
        -- All return values conform to the Agent SDK's PermissionResult
        -- schema: the allow branch carries updatedInput as a record, and
        -- the deny branch carries message as a non-empty string. A bare
        -- { behavior } is rejected by the SDK at runtime.
}

contract MultiTurnPromptStream {
    next_message: (session: Session) -> Any

    @invariant StreamExhaustion
        -- The stream yields the initial prompt followed by zero or
        -- more follow-up messages, then signals end-of-stream. After
        -- end-of-stream, subsequent calls signal end-of-stream
        -- (idempotent); the SDK does not call next_message after
        -- end-of-stream. The number of follow-up messages yielded is
        -- bounded by session.input.max_user_follow_ups; when the cap
        -- is zero or has been reached, the stream signals
        -- end-of-stream immediately after the initial prompt.
}

contract SessionPersistence {
    write_jsonl: (session_id: String, message: Any) -> Any

    @invariant FullConversationPreserved
        -- Every message exchanged with the agent (user, assistant text,
        -- tool uses, tool results, thinking, system) is written to the
        -- SDK's native JSONL file. scuttlerun surfaces the file's path
        -- in the preamble but never modifies its contents.
        --
        -- The SDK breaks this invariant when the disk is full or the
        -- quota is exhausted, and reports the breach once as the CLI
        -- exits (AgentSessionWritesLost). scuttlerun does not repair the
        -- file; it records the breach as `transcript_incomplete`.
}

contract AbortableExecution {
    abort: (session: Session) -> Any
    interrupt: (session: Session) -> Any

    @invariant TerminatesPromptlyOnAbort
        -- After abort and interrupt are signalled, the iterator stops
        -- producing messages within a bounded delay determined by the
        -- in-flight SDK iteration. scuttlerun additionally checks an
        -- internal flag at the top of each loop iteration to break
        -- promptly without waiting for the iterator to drain.
}

contract StructuredOutputParse {
    parse: (system_prompt: String, user_message: String, schema: Any) -> Any

    @invariant SchemaConformance
        -- Each parse is a one-shot Agent SDK query() with no tools and
        -- JSON-schema structured output; the structured output (or, when the
        -- SDK omits it, the result string parsed as JSON) is validated
        -- against the same schema. The call is retried with bounded
        -- exponential backoff, up to a fixed maximum number of attempts,
        -- before reporting a structured-output error to the caller. An SDK
        -- error-subtype result and a transport failure both count as
        -- retryable attempts; a semantic mismatch (e.g. an answer count that
        -- does not match the question count) re-prompts the next attempt
        -- with corrective feedback stating the expected shape.

    @invariant UsageReported
        -- Each attempt's SDK result message carries token-usage counts
        -- (input, output, cache-creation, cache-read) and total_cost_usd,
        -- the SDK's cost estimate for that query. Every attempt reports its
        -- usage and cost to the caller's accounting, whether or not its
        -- output passes validation; an attempt that ends without a result
        -- message, or whose result is an error subtype carrying a zero
        -- total_cost_usd (the SDK may zero a crash or startup-error
        -- result's figures), reports that its cost is unknown.
}
