-- allium: 3
-- scuttlerun.allium
--
-- Scope: Behaviour of the scuttlerun session driver from invocation to
-- termination. Distilled from src/ as of commit fed8d50.
--
-- Includes:
--   - Session lifecycle and outcome-to-exit-code mapping
--   - Synthetic user answering AskUserQuestion via an LLM oracle
--   - Reactive turn policy (oracle-driven follow-ups, capped per session)
--   - Workspace lifecycle: scaffold-or-bare, preservation, stale GC
--   - Cost accumulation across agent and oracle
--   - Streaming transcript shape (preamble / conversation / footer)
--
-- Excludes:
--   - YAML config schema and merge semantics (input presentation, not behaviour)
--   - Agent SDK protocol internals (message envelopes, async-iterator coordination)
--   - Anthropic Messages API integration details (oracle is a black box here)
--   - Sandbox enforcement (delegated to the Agent SDK; scuttlerun configures the sandbox via SessionInput.sandbox)
--   - Pricing table maintenance (a data file, not behaviour)

-- Self-reference. scuttlerun's external entities (AgentSdkClient,
-- AnthropicMessagesApi, Caller) sit at code-to-code or shell-to-process
-- boundaries; their governing specifications are upstream non-Allium
-- artefacts (the Agent SDK TypeScript types, the Anthropic Messages API
-- HTTP contract, and the operating system process model respectively).
-- This declaration anchors the module to a known coordinate so the
-- checker's missing-source-hint heuristic is satisfied without
-- inventing fictitious upstream Allium specs.
use "./scuttlerun.allium" as scuttlerun


-- =============================================================
-- Configuration
-- =============================================================

config {
    workspace_cleanup_age: Duration = 7.days
    oracle_context_entry_limit: Integer = 20
    default_session_timeout: Duration = 300.seconds
    default_max_agent_turns: Integer = 50
    default_max_user_follow_ups: Integer = 0
    default_agent_model: String = "claude-haiku-4-5"
    default_oracle_model: String = "claude-haiku-4-5"
    workspace_dir_prefix: String = "scuttlerun-project-"
}


-- =============================================================
-- External entities (caller inputs and integrations)
-- =============================================================

-- Caller-supplied configuration shape. Value type: no identity, no
-- lifecycle, immutable for the duration of a session.
value SessionInput {
    prompt: String
    agent_model: String
    oracle_model: String
    persona: String?
    max_agent_turns: Integer
    max_user_follow_ups: Integer
    max_budget_usd: Decimal?
    timeout: Duration
    permission_mode: `default` | `acceptEdits` | `bypassPermissions` | `plan` | `dontAsk`
    tools: List<String>
    disallowed_tools: List<String>?
    effort: low | medium | high | xhigh | max
    project: ProjectTemplate?
    sandbox: Sandbox

    @guidance
        -- prompt is forwarded verbatim to the Agent SDK as the initial
        -- user message; scuttlerun performs no slash-command expansion.
        -- A slash-command prompt (e.g. /plugin:skill ...) only resolves
        -- when the defining skill/plugin is loaded into the session (via
        -- project.skills, project.plugins, or sdk.plugins), which
        -- registers it among the session's available slash commands. When
        -- the prompt begins with a slash command that is not so
        -- registered, the runner emits a stderr warning at session start
        -- (the agent would otherwise receive it as literal text and
        -- typically run zero turns); the session still proceeds.
        --
        -- agent_model is supplied via the top-level YAML field model
        -- and defaults to config.default_agent_model when omitted.
        -- oracle_model is supplied via the YAML field user.oracle_model
        -- (under the top-level user section) and defaults to
        -- config.default_oracle_model when omitted.
        --
        -- max_user_follow_ups is supplied via the YAML field
        -- user.max_turns (under the top-level user section). The field
        -- on SessionInput represents the resolved value the runner
        -- enforces against synthetic_user.user_turn_count.
        --
        -- tools is the resolved post-merge available-tools list the
        -- runner hands to the Agent SDK — the base set of tools made
        -- available to the agent. The caller may supply two layers of
        -- tool input — a base list (YAML field tools) and an
        -- additional list (YAML field additional_tools) — and the
        -- resolved tools field represents both layers concatenated,
        -- with the additional entries appended after the base entries
        -- and duplicates removed on a first-wins basis. The list shape
        -- (rather than a set) is load-bearing: ordering is preserved
        -- so that downstream consumers see a deterministic sequence,
        -- and first-wins dedup means an additional entry that repeats
        -- a base entry is a no-op rather than a reorder.
        --
        -- timeout is supplied via the top-level YAML field timeout
        -- (in seconds) and defaults to config.default_session_timeout
        -- (300 seconds) when omitted; like other config values it flows
        -- through the base+scenario merge, so a scenario may override a
        -- base timeout. The --timeout CLI flag, when supplied, overrides
        -- the merged config value. The field on SessionInput represents
        -- the resolved value the runner enforces against
        -- session.started_at: CLI flag if passed, else the merged config
        -- value, else config.default_session_timeout.
        --
        -- effort is passed through to the Agent SDK as a reasoning
        -- effort knob. Default value handling lives in CLI/config and
        -- is out of spec scope.
}

value ProjectTemplate {
    claude_md: String?
    skills: List<String>
    plugins: List<String>
    settings: Map<String, Any>?
    files: Map<String, String>?
    git_init: Boolean

    @guidance
        -- plugins is the preferred caller surface for loading local
        -- plugins into the agent session. Each entry is a path string
        -- to a plugin directory (the directory containing
        -- .claude-plugin/plugin.json).
        --
        -- At session-start, each project.plugins entry is translated
        -- into a raw SDK plugin spec of shape (type: local, path: P)
        -- where P is the resolved absolute path. The resolved entries
        -- are concatenated with any caller-supplied raw sdk.plugins
        -- entries (project entries first), and duplicates are removed
        -- by resolved path on a first-wins basis. The order shape
        -- mirrors the tools / additional_tools precedence model
        -- documented on SessionInput.
        --
        -- Unlike project.skills, project.plugins does NOT scaffold
        -- workspace symlinks under .claude/plugins/ and does NOT read
        -- the plugin manifest at scaffold time. The translation is
        -- purely a shape-level rewrite of the caller's SessionInput
        -- before the Agent SDK is invoked. Per-plugin validation
        -- (whether the path exists, whether it is a valid plugin) is
        -- delegated to the Agent SDK.
}

value Sandbox {
    enabled: Boolean
    network: SandboxNetwork
    filesystem: SandboxFilesystem

    @guidance
        -- sandbox.enabled defaults to true. Callers must explicitly set
        -- enabled=false to opt out; the default-on posture is
        -- load-bearing for the HOME redirection and env-filter
        -- behaviour described on Workspace.
        --
        -- Network access is governed by the explicit allowlist on
        -- SandboxNetwork; an empty allowed_domains list means no
        -- domains are reachable. There is no global on/off network
        -- toggle separate from sandbox.enabled.
        --
        -- Filesystem access is governed by separate read and write
        -- denylists plus a write allowlist; there is no general read
        -- allowlist (read defaults to allowed except as denied). The
        -- read denylist defaults to common credential paths
        -- (~/.ssh, ~/.aws, ~/.config/gcloud) and the write denylist
        -- defaults to .env; these defaults apply only when the caller
        -- supplies no list of their own. Supplying a deny_read or
        -- deny_write list replaces the default in full, so callers
        -- who customise these lists must re-include any default
        -- entries they want to retain. The workspace path and /tmp
        -- are unconditionally writable in addition to whatever
        -- allow_write lists; callers do not need to (and cannot)
        -- revoke these two roots.
        --
        -- Bash auto-allow under the sandbox is not caller-configurable:
        -- when the sandbox is enabled, the runner always passes
        -- autoAllowBashIfSandboxed=true and allowUnsandboxedCommands=
        -- false to the Agent SDK.
}

value SandboxNetwork {
    allowed_domains: List<String>
    allow_local_binding: Boolean
}

value SandboxFilesystem {
    deny_read: List<String>
    allow_write: List<String>
    deny_write: List<String>
}

-- The Agent SDK process scuttlerun drives. Code-to-code boundary.
external entity AgentSdkClient {}

-- The Anthropic Messages API the oracle calls. Code-to-code boundary.
external entity AnthropicMessagesApi {}

-- The shell/script invoking scuttlerun.
external entity Caller {}


-- =============================================================
-- Domain entities
-- =============================================================

entity Session {
    input: SessionInput
    workspace: Workspace
    started_at: Timestamp
    sdk_session_id: String?

    status: pending | running | completed_success
          | exhausted_turns | exhausted_budget | failed | timed_out
          | interrupted

    turn_count: Integer
    tool_call_count: Integer
    agent_cost: Decimal
    oracle_cost: Decimal
    cost_incomplete: Boolean
    timed_out_observed: Boolean

    transitions status {
        pending -> running
        running -> completed_success
        running -> exhausted_turns
        running -> exhausted_budget
        running -> failed
        running -> timed_out
        running -> interrupted
        terminal: completed_success, exhausted_turns, exhausted_budget, failed, timed_out, interrupted
    }

    is_terminated: status in {completed_success, exhausted_turns,
                              exhausted_budget, failed, timed_out,
                              interrupted}
    total_cost: agent_cost + oracle_cost

    transcript: Transcript with session = this
    synthetic_user: SyntheticUser? with session = this

    @guidance
        -- status is a logical/observable property of the session, not a
        -- persisted field. Its terminal value is reflected in the OS exit
        -- code (see mapping below) rather than written to storage.
        --
        -- Exit code mapping (emitted to the OS on termination):
        --   completed_success → 0
        --   failed            → 2 (runtime error)
        --   exhausted_budget  → 5
        --   timed_out         → 6
        --   exhausted_turns   → 7
        --   interrupted       → 130 (SIGINT/SIGTERM)
        -- Code 1 (configuration error) is emitted before a Session exists
        -- and so is not represented here. Codes 3 and 4 belong to upstream
        -- tooling in the scuttlerun/pincenez/craboodle taxonomy and are
        -- never produced by scuttlerun.
}

-- The temporary directory that becomes the agent's working directory.
-- Always created, even when no template is supplied.
entity Workspace {
    path: String
    created_at: Timestamp
    last_modified: Timestamp

    @guidance
        -- When the sandbox is enabled, HOME is redirected to
        -- <workspace>/.home so that the agent process does not read or
        -- write the operator's home directory. This applies regardless
        -- of whether the workspace was scaffolded from a project
        -- template.
        --
        -- A single carve-out exists for OAuth authentication: when no
        -- ANTHROPIC_API_KEY is set on the parent process and the
        -- operator's real-home credentials file exists, that one file
        -- (~/.claude/.credentials.json) is exposed inside the sandbox
        -- via a symlink at <workspace>/.home/.claude/.credentials.json.
        -- Nothing else under the operator's ~/.claude/ is reachable
        -- from the agent subprocess; skills, plugins, commands, agents,
        -- settings, prior session history and other operator state stay
        -- invisible. The carve-out is silently skipped when an API key
        -- is set or when no credentials file exists.
        --
        -- When the sandbox is enabled and that carve-out links nothing
        -- — no ANTHROPIC_API_KEY, no CLAUDE_CODE_OAUTH_TOKEN, and no
        -- credentials file to expose — the agent subprocess has no
        -- credential it can reach (a macOS subscription `claude /login`
        -- stores its credential in the Keychain, which the sandbox
        -- cannot see). The runner emits a stderr warning at session
        -- start so this surfaces as actionable guidance rather than an
        -- opaque downstream authentication failure. The diagnostic is
        -- scoped to sandboxed sessions: without the sandbox the
        -- subprocess inherits the real HOME and can read the Keychain
        -- directly, so no such determination is made.
        --
        -- When session.input.sandbox.enabled, the agent subprocess
        -- receives only an allowlisted set of environment variables
        -- (plus any user-supplied sdk.env overrides applied on top).
        -- The behavioural shape is: env is filtered, not inherited.
        -- The contents of the allowlist are a code-level concern and
        -- are not enumerated here.
        --
        -- last_modified reflects the filesystem mtime of the workspace
        -- directory, not an in-memory write-tracking value. It is
        -- updated by the operating system in response to file activity
        -- inside the workspace and is read back from the filesystem
        -- when StaleWorkspaceCleanup evaluates whether a workspace is
        -- old enough to reclaim.
}

-- The LLM-driven simulation of the human user.
entity SyntheticUser {
    session: Session
    persona: String?
    user_turn_count: Integer

    has_remaining_follow_ups:
        user_turn_count < session.input.max_user_follow_ups

    @guidance
        -- The synthetic user only forwards the most recent
        -- config.oracle_context_entry_limit user/assistant entries of
        -- the conversation buffer to the oracle. Earlier entries are
        -- dropped. Tool uses, tool results and thinking blocks are
        -- stripped before entries enter the conversation buffer.
}

-- An entry in the synthetic user's conversation buffer. A marker
-- entity recording role and ordering. The actual text payload is
-- observable through the transcript and the SDK session JSONL rather
-- than persisted on the entity model; the structural assertion here
-- is that only entries whose role is in {user, assistant} ever enter
-- the buffer (see OnlyTextReachesOracleContext).
entity ConversationEntry {
    synthetic_user: SyntheticUser
    sequence: Integer
    role: user | assistant
}

-- A clarifying question request from the agent (AskUserQuestion tool).
-- A marker entity recording that a request was received and routed
-- to the oracle. Question payload, oracle answers, reasoning and
-- token usage are observable through the transcript and footer
-- rather than persisted on the entity model.
entity ClarifyingQuestionRequest {
    session: Session
}

-- A turn-policy decision about whether to send a follow-up. A marker
-- entity recording that the policy was evaluated for a session. The
-- decision (continue or end), follow-up message, and oracle reasoning
-- are observable through the transcript's oracle_turn entry rather
-- than persisted on the entity model.
entity TurnEvaluation {
    session: Session
}

-- Streamed YAML output to stdout. Observable while the session runs.
entity Transcript {
    session: Session
    entries: List<TranscriptEntry> with transcript = this
    finalized: Boolean
}

entity TranscriptEntry {
    transcript: Transcript
    sequence: Integer
    kind: user_message | assistant_text | thinking
        | tool_call | oracle_ask | oracle_turn | oracle_error
}


-- =============================================================
-- Rules: Session lifecycle
-- =============================================================

rule SessionStarts {
    when: SessionRequested(caller, input, started_at)

    -- Best-effort cleanup of stale workspaces from prior runs.
    -- Failures are silently ignored; this is not on the critical path.
    ensures: StaleWorkspaceCleanup(config.workspace_cleanup_age)

    ensures: Workspace.created(
        created_at: started_at,
        last_modified: started_at
    )
    ensures: Session.created(
        input: input,
        started_at: started_at,
        status: pending,
        turn_count: 0,
        tool_call_count: 0,
        agent_cost: 0,
        oracle_cost: 0,
        cost_incomplete: false,
        timed_out_observed: false
    )

    @guidance
        -- StaleWorkspaceCleanup is fire-and-forget: it is dispatched
        -- when the session starts but is not sequenced before the new
        -- Workspace is created. The two ensures may complete in either
        -- order, and the cleanup's success or failure does not block
        -- session startup. The order shown here is logical, not
        -- temporal.
}

rule SessionScaffoldsSkills {
    when: SessionRequested(caller, input, started_at)

    requires: input.project != null

    for skill_path in input.project.skills:
        for workspace in Workspaces where workspace.created_at = started_at:
            ensures: SkillReferenced(input.project, skill_path, workspace)

    @guidance
        -- Each skill path declared on the project template is announced
        -- to the workspace just created for this session, kicking off
        -- scaffold-time validation in WorkspaceScaffoldsSkill.
}

rule SessionBecomesRunning {
    when: AgentInitialized(client, session)

    requires: session.status = pending

    ensures: session.status = running
    ensures: SyntheticUser.created(
        session: session,
        persona: session.input.persona,
        user_turn_count: 0
    )
    ensures: TranscriptEntry.created(
        transcript: session.transcript,
        kind: user_message
    )
    -- The initial prompt enters the synthetic user's conversation
    -- buffer so the oracle has context on the very first follow-up
    -- or clarifying question. Subsequent user entries are added by
    -- TurnPolicyContinues.
    ensures: ConversationEntry.created(
        synthetic_user: session.synthetic_user,
        role: user
    )

    @guidance
        -- The Agent SDK emits an init message with a session_id at the
        -- start of each query turn. scuttlerun captures the first one
        -- and uses it to identify the SDK session file.
}

rule SessionFinalises {
    when: session: Session.is_terminated

    ensures: session.transcript.finalized = true
    ensures: AgentSdkClosed(session)

    @guidance
        -- Fires once when the session enters any terminal state. The
        -- workspace is preserved on every termination path; reclamation
        -- happens on the next session start via StaleWorkspaceCleanup.
        -- The agent SDK child process is closed via query.close().
}


-- =============================================================
-- Rules: AskUserQuestion handling
-- =============================================================

rule SyntheticUserAnswersClarifyingQuestion {
    when: AgentAsksClarifyingQuestion(client, session)

    requires: session.status = running
    requires: exists session.synthetic_user

    ensures: ClarifyingQuestionRequest.created(session: session)
    ensures: TranscriptEntry.created(
        transcript: session.transcript,
        kind: oracle_ask
    )
    ensures: AgentReceivesAnswers(session)

    @guidance
        -- AskUserQuestion is only intercepted when "AskUserQuestion" is in
        -- session.input.tools. If absent, the agent has no way to call the
        -- tool and the synthetic user never engages.
        --
        -- The oracle is consulted with: the persona, the most recent
        -- conversation pairs (text only), and the questions. It returns
        -- an answer per question (option label or free text) plus
        -- reasoning. Tool uses, tool results and thinking blocks never
        -- appear in oracle prompts.
        --
        -- The oracle's call is retried with bounded exponential backoff
        -- before the session is terminated as a runtime error. Both a
        -- transport failure and a malformed answer set (an answer count that
        -- does not match the question count) are retryable: on a count
        -- mismatch the oracle is re-consulted with corrective feedback
        -- stating the expected count, and the session is terminated as a
        -- runtime error only if the mismatch persists across every attempt.
        --
        -- The oracle is instructed to return exactly one answer per question
        -- regardless of how many options a question carries (never one
        -- answer per option), and to encode a multi-select answer as a
        -- single entry listing the chosen labels.
        --
        -- Answers are associated to the input questions positionally (the
        -- i-th oracle answer pairs with the i-th input question) and keyed
        -- by the input question's exact text, so the agent's answer lookup
        -- resolves regardless of how the oracle echoes the question text.
}


-- =============================================================
-- Rules: Reactive turn policy
-- =============================================================

rule AgentTurnSucceeds {
    when: AgentTurnCompleted(client, session, subtype, terminal_reason, agent_cost_to_date, num_turns_to_date)

    requires: session.status = running
    requires: subtype = success

    ensures: session.agent_cost = agent_cost_to_date
    ensures: session.turn_count = num_turns_to_date
    ensures: TurnPolicyConsultation(session)

    @guidance
        -- Turn-policy consultation is unconditional after every
        -- successful agent turn. Both short-circuits — the cap=0
        -- single-turn case and the cap-reached case — live in the
        -- turn-policy machinery (TurnPolicyCapped, whose guard
        -- not has_remaining_follow_ups holds when max_user_follow_ups
        -- is zero or already consumed) and end the session without
        -- invoking the oracle. This mirrors the runner's control
        -- flow, which always calls decideTurn() after a successful
        -- agent turn and lets decideTurn() decide whether to
        -- contact the oracle.
        --
        -- num_turns_to_date is the SDK-reported cumulative count of
        -- agent turns completed in this session up to and including
        -- this result. scuttlerun mirrors the SDK's count rather
        -- than maintaining an independent counter, matching the
        -- snapshot idiom used for agent_cost_to_date.
}

rule TurnPolicyCapped {
    when: TurnPolicyConsultation(session)

    requires: session.status = running
    requires: not session.synthetic_user.has_remaining_follow_ups

    -- Short-circuit: the cap has been reached, so the turn policy
    -- ends the session without contacting the oracle. The decision
    -- still surfaces as a TurnPolicyDecided event so that downstream
    -- handling (TurnPolicyEnds) is uniform.
    ensures: TurnPolicyDecided(session, end, null, null)
}

rule TurnPolicyConsultsOracle {
    when: TurnPolicyConsultation(session)

    requires: session.status = running
    requires: session.synthetic_user.has_remaining_follow_ups

    -- The oracle is contacted; its decision arrives later as
    -- TurnPolicyDecided and is handled by TurnPolicyContinues or
    -- TurnPolicyEnds.
    ensures: OracleConsultedForTurnPolicy(session)
}

rule TurnPolicyContinues {
    when: TurnPolicyDecided(session, decision, message, reasoning)

    requires: session.status = running
    requires: decision = continue
    requires: session.synthetic_user.has_remaining_follow_ups

    let synthetic = session.synthetic_user

    ensures: TurnEvaluation.created(session: session)
    ensures: synthetic.user_turn_count = synthetic.user_turn_count + 1
    ensures: ConversationEntry.created(
        synthetic_user: synthetic,
        role: user
    )
    ensures: TranscriptEntry.created(
        transcript: session.transcript,
        kind: oracle_turn
    )
    ensures: TranscriptEntry.created(
        transcript: session.transcript,
        kind: user_message
    )
    ensures: AgentReceivesFollowUp(session, message)
}

rule TurnPolicyEndsByOracle {
    when: TurnPolicyDecided(session, decision, message, reasoning)

    requires: session.status = running
    requires: session.timed_out_observed = false
    requires: decision = end
    requires: reasoning != null

    ensures: TurnEvaluation.created(session: session)
    ensures: TranscriptEntry.created(
        transcript: session.transcript,
        kind: oracle_turn
    )
    ensures: session.status = completed_success
}

rule TurnPolicyEndsByCap {
    when: TurnPolicyDecided(session, decision, message, reasoning)

    requires: session.status = running
    requires: session.timed_out_observed = false
    requires: decision = end
    requires: reasoning = null

    -- Cap-driven termination: the session ends without consulting the
    -- oracle, so no oracle_turn transcript entry is emitted. The
    -- TurnEvaluation marker is still recorded for completeness.
    ensures: TurnEvaluation.created(session: session)
    ensures: session.status = completed_success
}

rule AgentTurnExhaustsTurns {
    when: AgentTurnCompleted(client, session, subtype, terminal_reason, agent_cost_to_date, num_turns_to_date)

    requires: session.status = running
    requires: session.timed_out_observed = false
    requires: subtype = error_max_turns

    ensures: session.agent_cost = agent_cost_to_date
    ensures: session.turn_count = num_turns_to_date
    ensures: session.status = exhausted_turns
}

rule AgentTurnHitsTurnCapDuringExecution {
    when: AgentTurnCompleted(client, session, subtype, terminal_reason, agent_cost_to_date, num_turns_to_date)

    requires: session.status = running
    requires: session.timed_out_observed = false
    requires: subtype = error_during_execution
    requires: terminal_reason = max_turns

    ensures: session.agent_cost = agent_cost_to_date
    ensures: session.turn_count = num_turns_to_date
    ensures: session.status = exhausted_turns

    @guidance
        -- The turn cap can be reached mid-execution: the SDK accepts and
        -- processes a tool/skill call as the Nth tool use, then cannot
        -- start the next model turn. The result subtype is
        -- error_during_execution (not error_max_turns), but the SDK
        -- attributes the terminal cause via terminal_reason = max_turns.
        -- scuttlerun keys on terminal_reason to map this to
        -- exhausted_turns (exit 7) rather than a runtime failure (exit
        -- 2), so the same logical condition — the turn cap — yields the
        -- same exit code regardless of where in the tool-call lifecycle
        -- it fired. Disjoint from AgentTurnFailsAtRuntime, which carries
        -- the complementary `terminal_reason != max_turns` guard.
}

rule AgentTurnExhaustsBudget {
    when: AgentTurnCompleted(client, session, subtype, terminal_reason, agent_cost_to_date, num_turns_to_date)

    requires: session.status = running
    requires: session.timed_out_observed = false
    requires: subtype = error_max_budget_usd

    ensures: session.agent_cost = agent_cost_to_date
    ensures: session.turn_count = num_turns_to_date
    ensures: session.status = exhausted_budget
}

rule AgentTurnFailsAtRuntime {
    when: AgentTurnCompleted(client, session, subtype, terminal_reason, agent_cost_to_date, num_turns_to_date)

    requires: session.status = running
    requires: session.timed_out_observed = false
    requires: subtype = error_during_execution
    requires: terminal_reason != max_turns

    ensures: session.agent_cost = agent_cost_to_date
    ensures: session.turn_count = num_turns_to_date
    ensures: session.status = failed

    @guidance
        -- An error_during_execution result is a genuine runtime failure
        -- only when its terminal_reason is not the turn cap; the
        -- `terminal_reason != max_turns` guard (which an absent /
        -- undefined terminal_reason also satisfies) keeps this rule
        -- disjoint from AgentTurnHitsTurnCapDuringExecution, which claims
        -- the mid-execution turn-cap case for exhausted_turns instead.
        --
        -- When the result message carries SDK error detail (the
        -- `errors` string array on the error result), the runner writes
        -- a single `[scuttlerun] <joined errors>` line to stderr as a
        -- diagnostic annotation paired with the runtime-error exit code,
        -- mirroring the timeout diagnostic in `SessionTimesOut`. The
        -- line is informational and downstream tools should not parse
        -- it; an empty or absent `errors` array emits nothing. This is
        -- what makes a runtime failure observable instead of surfacing
        -- only as a bare exit code 2.
}

rule SessionFailsFromUncaughtException {
    when: RunnerCaughtException(session)

    requires: session.status = running
    requires: session.timed_out_observed = false

    ensures: session.status = failed
    -- No result message reported the in-flight turn's cost, so the agent
    -- cost in the footer is incomplete/unknown rather than a confirmed $0.
    ensures: session.cost_incomplete = true

    @guidance
        -- Witnesses the running -> failed edge for exceptions that
        -- escape the message-processing loop without arriving as an
        -- AgentTurnCompleted result (for example, an SDK iterator
        -- failure, a writer error or any other thrown error). The
        -- agent_cost and turn_count snapshots are not updated on
        -- this path because no result message reported new values;
        -- whatever last value the AgentTurnCompleted handlers wrote
        -- is preserved. Coincident timeouts are excluded by the
        -- `timed_out_observed` guard, which keeps this rule disjoint
        -- from `SessionTimesOut`.
        --
        -- Mid-stream SDK failures are not retried and the session is
        -- not resumed by session_id: the failed terminal status is
        -- final. Retry/resume granularity is intentionally out of
        -- scope; only the oracle and StructuredOutputParse contracts
        -- carry bounded retries with backoff (see
        -- SyntheticUserAnswersClarifyingQuestion and
        -- StructuredOutputParse.SchemaConformance).
        --
        -- On this non-timeout, non-signal exception path the runner
        -- writes a single `[scuttlerun] <exception message>` line to
        -- stderr as a diagnostic annotation paired with the
        -- runtime-error exit code (same informational, do-not-parse
        -- contract as the timeout and AgentTurnFailsAtRuntime
        -- diagnostics). The timeout and signal branches keep their own
        -- handling and do not emit this line.
}

rule SessionTimeoutObserved {
    when: session: Session.started_at + session.input.timeout <= now

    requires: session.status = running
    requires: session.timed_out_observed = false

    ensures: session.timed_out_observed = true
    ensures: TimeoutObserved(session)

    @guidance
        -- Observer half of the timeout split. Fires on the temporal
        -- predicate (deadline reached while the session is still
        -- running), flips the `timed_out_observed` flag and emits the
        -- TimeoutObserved chained trigger consumed by `SessionTimesOut`.
        -- The `timed_out_observed = false` precondition is the standard
        -- temporal-trigger re-fire guard. This rule does not write
        -- `status`; the terminal transition is committed by
        -- `SessionTimesOut` from the chained trigger.
}

rule SessionTimesOut {
    when: TimeoutObserved(session)

    requires: session.status = running
    requires: session.timed_out_observed = true

    ensures: session.status = timed_out
    ensures: AgentInterrupted(session)
    -- The in-flight turn was aborted before its result, so the agent cost
    -- in the footer is incomplete/unknown rather than a confirmed $0.
    ensures: session.cost_incomplete = true

    @guidance
        -- Committer half of the timeout split. Consumes the chained
        -- TimeoutObserved trigger emitted by `SessionTimeoutObserved`,
        -- writes the terminal `status = timed_out` and signals the
        -- agent abort. On timeout scuttlerun aborts the SDK abort
        -- controller and calls queryHandle.interrupt() as a
        -- belt-and-suspenders signal. The runner also writes a single
        -- `[scuttlerun] timed out after Xs` line to stderr (where X
        -- is the configured timeout in seconds) as a diagnostic
        -- annotation paired with the `timed_out` exit code; the
        -- message is informational and downstream tools should not
        -- parse it. The transcript footer is still emitted with
        -- whatever stats accrued. The terminal status reflects the
        -- timeout regardless of whether the for-await loop unwound
        -- normally or via an exception thrown mid-iteration: the
        -- runner's catch path checks the timed-out flag and resolves
        -- to timed_out either way.
        --
        -- The observe-then-commit split exists so the analyser sees
        -- the status-writing rule as disjoint from the six other
        -- rules that transition Session.status out of running:
        -- `SessionTimesOut` requires `timed_out_observed = true`,
        -- which only `SessionTimeoutObserved` can produce, while the
        -- other six rules require `timed_out_observed = false`. The
        -- shape mirrors the runner, which sets an in-memory
        -- `timedOut` flag when the abort fires and checks it at the
        -- top of the for-await loop to resolve the terminal status.
        -- `timed_out_observed` is a spec-level field that exists to
        -- make timeout precedence visible as a value-predicate guard;
        -- it does not correspond to a persisted runtime field.
}

rule SessionInterruptedByOperator {
    when: OperatorSignalReceived(session)

    requires: session.status = running
    requires: session.timed_out_observed = false

    ensures: session.status = interrupted
    ensures: AgentInterrupted(session)
    -- The in-flight turn was aborted before its result, so the agent cost
    -- in the footer is incomplete/unknown rather than a confirmed $0.
    ensures: session.cost_incomplete = true

    @guidance
        -- The operator interrupted the running session by sending
        -- SIGINT or SIGTERM to the scuttlerun process. scuttlerun aborts
        -- the SDK abort controller and calls queryHandle.interrupt() to
        -- stop the in-flight turn, then commits the terminal status.
        -- The transcript footer is still emitted with whatever stats
        -- accrued. Coincident timeouts are excluded by the
        -- `timed_out_observed` guard, which keeps this rule disjoint
        -- from `SessionTimesOut` and from the failure paths: if the
        -- timeout observer has already fired, the session resolves to
        -- timed_out regardless of any later signal.
}


-- =============================================================
-- Rules: Workspace lifecycle
-- =============================================================

rule StaleWorkspacesRemoved {
    when: StaleWorkspaceCleanup(older_than)

    for workspace in Workspaces
        where starts_with(workspace.path, config.workspace_dir_prefix)
        and workspace.last_modified + older_than <= now:
        ensures: not exists workspace

    @guidance
        -- Best-effort: filesystem failures (permission errors, races) are
        -- silently ignored. Never touches directories outside $TMPDIR.
        -- Never touches directories without the scuttlerun-project- prefix.
        -- Never touches directories from the current or recent sessions
        -- (mtime is the gate).
        --
        -- workspace_cleanup_age is a project-level constant defined in
        -- the config block; it is intentionally not exposed in
        -- SessionInput or via environment overrides. Per-session or
        -- per-invocation tuning is out of scope.
}

rule WorkspaceScaffoldsSkill {
    when: SkillReferenced(template, skill_path, workspace)

    requires: is_directory(skill_path)
    requires: has_skill_md(skill_path)

    ensures: SkillSymlinked(skill_path, workspace)

    @guidance
        -- skill_path is one entry from project.skills (a raw path string).
        -- All skill paths are validated before any filesystem mutation
        -- occurs: each path must resolve to a directory containing a
        -- SKILL.md file. A failed skill validation rejects the entire
        -- session as a configuration error (exit 1) — no partial
        -- scaffolding remains. Skills are symlinked into
        -- <workspace>/.claude/skills/<name>/, not copied.
}


-- =============================================================
-- Rules: Streaming events to the transcript and conversation buffer
-- =============================================================

rule AssistantTextEmitted {
    when: AgentEmitsAssistantMessage(client, session, text_blocks)

    requires: session.status = running
    requires: text_blocks.count > 0

    -- One transcript entry per text block in the assistant message.
    for block in text_blocks:
        ensures: TranscriptEntry.created(
            transcript: session.transcript,
            kind: assistant_text
        )

    -- One conversation entry per assistant message regardless of
    -- how the model split its reply into blocks. The text payload
    -- the buffer carries is the newline-joined concatenation of
    -- every text block; this pairs the assistant turn with a single
    -- user-side entry in the oracle context.
    ensures: ConversationEntry.created(
        synthetic_user: session.synthetic_user,
        role: assistant
    )
}

rule AssistantThinkingEmitted {
    when: AgentEmitsThinking(client, session, text)

    requires: session.status = running

    -- Thinking reaches the transcript but never the oracle context.
    ensures: TranscriptEntry.created(
        transcript: session.transcript,
        kind: thinking
    )
}

rule AssistantToolCallEmitted {
    when: AgentEmitsToolCall(client, session, tool_name)

    requires: session.status = running

    -- Tool calls reach the transcript but never the oracle context.
    ensures: TranscriptEntry.created(
        transcript: session.transcript,
        kind: tool_call
    )
    ensures: session.tool_call_count = session.tool_call_count + 1
}


-- =============================================================
-- Rules: Cost accumulation
-- =============================================================

rule OracleCallTracked {
    when: OracleCallCompleted(api, session, usage)

    ensures: session.oracle_cost = session.oracle_cost
        + (usage.input_tokens * input_rate(session.input.oracle_model)
         + usage.output_tokens * output_rate(session.input.oracle_model)
         + usage.cache_creation_input_tokens * cache_creation_rate(session.input.oracle_model)
         + usage.cache_read_input_tokens * cache_read_rate(session.input.oracle_model))
            / 1_000_000

    @guidance
        -- The cost increment combines input, output, cache-creation and
        -- cache-read token counts reported by the API call with the
        -- model's per-million-token rates: input tokens times the input
        -- rate, output tokens times the output rate, plus cache-creation
        -- and cache-read tokens against their own rate columns. The
        -- cache columns are derived from the input rate by fixed
        -- multipliers: cache-creation tokens are billed at 1.25 times
        -- the input rate, and cache-read tokens at 0.10 times the input
        -- rate. Unknown models fall back to a family rate or to the
        -- default oracle model's rate; the rate-table lookup is
        -- implementation detail.
        --
        -- The per-call accumulation expressed by this rule is the
        -- logical model. The implementation accumulates raw token
        -- totals across calls and computes the cost once at session
        -- finalisation; intermediate session.oracle_cost values are
        -- not observable to callers and need not match per-call
        -- arithmetic until the footer is emitted.
}


-- =============================================================
-- Invariants
-- =============================================================

invariant WorkspacePreservedAcrossOutcomes {
    -- The workspace owning a terminated session always still exists at
    -- the moment of termination. Reclamation is deferred to the next
    -- session's startup GC.
    for session in Sessions:
        session.is_terminated implies exists session.workspace
}

invariant ScaffoldedFilesStayInProject {
    -- Files declared by ProjectTemplate.files cannot escape the
    -- workspace nor target .git/. Path traversal and .git/ injection
    -- are rejected as configuration errors before any file is written.
    --
    -- escapes_workspace is a realpath-style check: the candidate path
    -- is resolved relative to the workspace root and the result must
    -- remain inside the workspace. Interior `..` segments that
    -- resolve back inside the workspace (for example
    -- `subdir/../file`) are permitted; only paths whose resolved form
    -- lies outside the workspace are rejected.
    for session in Sessions where session.input.project != null
                              and session.input.project.files != null:
        for (path, _) in session.input.project.files:
            path != ".git"
            and not starts_with(path, ".git/")
            and not escapes_workspace(path)
            and not starts_with(path, "/")
}

invariant FollowUpsRespectCap {
    -- The number of follow-up messages the synthetic user yields never
    -- exceeds the configured cap. Single-turn mode (cap = 0) yields none.
    for synthetic in SyntheticUsers:
        synthetic.user_turn_count <= synthetic.session.input.max_user_follow_ups
}

invariant AgentTurnCapAtLeastOne {
    -- The agent turn cap is bounded below by one: a session must permit
    -- at least one agent turn. The user-side cap (max_user_follow_ups)
    -- has no such floor and may be zero (single-turn mode).
    for session in Sessions:
        session.input.max_agent_turns >= 1
}

invariant OnlyTextReachesOracleContext {
    -- The conversation buffer the oracle sees contains only user text and
    -- assistant text blocks. Tool uses, tool results and thinking blocks
    -- are stripped before insertion.
    for entry in ConversationEntries:
        entry.role in {user, assistant}
}

invariant SinglePersonaPerSession {
    -- The persona supplied at session start drives every oracle call for
    -- the entire session. There is no per-turn persona override and no
    -- discrimination between main-agent and subagent-origin clarifying
    -- questions: both go through the same oracle path with the same
    -- persona.
    for synthetic in SyntheticUsers:
        synthetic.persona = synthetic.session.input.persona
}


-- =============================================================
-- Surfaces
-- =============================================================

surface CommandLineInvocation {
    facing caller: Caller

    context session: Session

    exposes:
        session.turn_count
        session.tool_call_count
        session.total_cost
        session.cost_incomplete
        session.workspace.path
        session.transcript

    provides:
        SessionRequested(caller, session.input, session.started_at)
        OperatorSignalReceived(session)

    @guarantee Headless
        -- The CLI runs without an interactive TTY: stdin is closed for
        -- agent input, stdout streams the YAML transcript, and stderr
        -- carries diagnostics only. permission_mode defaults to
        -- `bypassPermissions` (chosen so the headless invocation does
        -- not block on a TTY-less permission prompt). When
        -- permission_mode is `bypassPermissions`, tool permission
        -- prompts are bypassed entirely; under other permission modes,
        -- the SDK may surface prompts and the operator must answer
        -- them on stdin explicitly.

    @guarantee SingleSessionPerInvocation
        -- One invocation runs exactly one session and produces exactly one
        -- transcript. Batch orchestration, grading and aggregation are
        -- explicitly out of scope.

    @guarantee ExitCodeReflectsOutcome
        -- The process exit code maps to session.status (see Session
        -- @guidance). Exit code 1 is reserved for configuration errors
        -- raised before a Session is created.
}

surface StreamingTranscript {
    facing reader: Caller

    context session: Session

    exposes:
        session.sdk_session_id
        session.workspace.path
        for entry in session.transcript.entries:
            entry.sequence
            entry.kind

    @guarantee StreamingYaml
        -- Output is a single YAML document streamed as the session runs:
        -- a preamble mapping, a `conversation:` sequence with one entry
        -- per event, and a footer mapping. The preamble carries four
        -- keys: `session` (the SDK session id), `config` (the path or
        -- list of paths to the YAML config files supplied at
        -- invocation), `project` (the workspace path) and
        -- `transcript` (the SDK session JSONL path). The footer
        -- always carries `turns` (count), `tool_calls` (count) and
        -- `duration_s` (seconds). Additional keys appear conditionally:
        -- `cost_usd` (Decimal: agent + oracle total) appears when the
        -- total is greater than zero; `oracle_cost_usd` (Decimal)
        -- appears when the oracle cost is greater than zero;
        -- `oracle_usage` appears when the oracle has been called at
        -- least once and is a flat mapping with `input_tokens`,
        -- `output_tokens`, `cache_creation_input_tokens`,
        -- `cache_read_input_tokens`, `calls` and `cost_usd`;
        -- `cost_incomplete` (Boolean) appears only when truthy and means
        -- the session terminated before the in-flight turn reported a
        -- final result, so the agent cost shown or omitted is
        -- incomplete/unknown rather than a confirmed $0;
        -- `timed_out`
        -- (Boolean) appears only when truthy; and `files_written`,
        -- `files_edited`, `files_read` each appear only when their
        -- respective list is non-empty. Long single-line strings render
        -- in block-folded (`>`) style; multi-line strings render in
        -- block-literal (`|`) style. Lines exceeding 80 columns in the
        -- final output are wrapped — by the YAML serializer for
        -- block-folded scalars and by hard-wrapping at word boundaries
        -- for block-literal scalars. Strings without any whitespace
        -- break point are preserved verbatim even when longer than 80
        -- columns.

    @guarantee InspectableMidSession
        -- A reader joining mid-session sees the preamble plus all entries
        -- emitted so far. The footer appears only after termination.

    @guarantee FullConversationInJsonl
        -- The full native conversation (including tool uses, tool results
        -- and thinking) is preserved by the Agent SDK in a JSONL file
        -- whose path is announced in the preamble. scuttlerun does not
        -- own this file.

    @guarantee TranscriptToolFieldContract
        -- The transcript captures tool invocations as observations, not
        -- as faithful reproductions of tool inputs. For each named tool
        -- below, the entry carries exactly the listed fields (in addition
        -- to `tool:` and `sequence:`); all other input fields the agent
        -- supplied are intentionally dropped from the YAML transcript.
        -- The SDK JSONL (see `FullConversationInJsonl`) is the source of
        -- truth for full tool inputs.
        --
        --   * Read, Write, Edit  → `path` (from `file_path`).
        --     Content-bearing fields (`content`, `old_string`,
        --     `new_string`) do NOT appear in the transcript. Downstream
        --     graders cannot assert on what was written or replaced from
        --     the transcript alone.
        --   * Bash               → `command`.
        --   * Glob, Grep         → `pattern`.
        --   * TodoWrite          → `todos` (full array).
        --   * TaskCreate         → `subject`, `description`.
        --   * TaskUpdate         → `task_id` (from `taskId`); `status`
        --     only when supplied.
        --   * TaskList           → no extra fields.
        --   * TaskGet            → `task_id` (from `taskId`).
        --   * Any other tool name → the full `input` mapping is emitted
        --     verbatim under an `input:` key.
        --
        -- Downstream, pincenez embeds a copy of this contract in its
        -- judge prompts (buildTranscriptFieldContractSection in
        -- pincenez's src/prompt.ts, shared by its grader and lint
        -- system prompts). Changing the captured fields obliges
        -- updating that section in lockstep.
}

surface AgentSdkBoundary {
    facing client: AgentSdkClient

    context session: Session

    exposes:
        session.sdk_session_id
        session.workspace.path

    provides:
        AgentInitialized(client, session)
        AgentTurnCompleted(client, session, subtype, terminal_reason, agent_cost_to_date, num_turns_to_date)
        AgentAsksClarifyingQuestion(client, session)
        AgentEmitsAssistantMessage(client, session, text_blocks)
        AgentEmitsThinking(client, session, text)
        AgentEmitsToolCall(client, session, tool_name)
        RunnerCaughtException(session)

    contracts:
        fulfils ToolPermissionCallback
        demands MultiTurnPromptStream
        demands SessionPersistence
        demands AbortableExecution

    @guidance
        -- session.input.disallowed_tools is the deny list scuttlerun
        -- passes to the Agent SDK alongside the allow list. Under
        -- permission_mode = `bypassPermissions` the SDK skips its
        -- normal prompt-and-allow flow, so disallowed_tools is the
        -- only mechanism that blocks tool calls in that mode. Under
        -- the other permission modes the deny list still applies but
        -- is layered on top of the mode's own enforcement.
}

surface OracleApiBoundary {
    facing api: AnthropicMessagesApi

    context session: Session

    provides:
        OracleCallCompleted(api, session, usage)
        TurnPolicyDecided(session, decision, message, reasoning)

    contracts:
        demands StructuredOutputParse
}


-- =============================================================
-- Contracts
-- =============================================================

contract ToolPermissionCallback {
    decide: (tool_name: String, input: Any) -> Any

    @invariant AskUserQuestionAnswered
        -- For tool_name = "AskUserQuestion", the result is
        -- { behavior: "allow", updatedInput: { questions, answers } }
        -- where answers come from the oracle and reflect the configured
        -- persona. If the input does not parse as a list of questions,
        -- the result is { behavior: "deny", message: <string> }.

    @invariant OtherToolsPassThrough
        -- For tool_name != "AskUserQuestion", the result is
        -- { behavior: "allow", updatedInput: input } — i.e. the caller's
        -- input is passed through unchanged. The configured permission_mode
        -- is responsible for any further enforcement; the callback itself
        -- adds no extra restriction.

    @invariant PermissionResultShapeMatchesSdkSchema
        -- All return values conform to the Agent SDK's PermissionResult
        -- schema: the allow branch carries updatedInput as a record, and
        -- the deny branch carries message as a non-empty string. A bare
        -- { behavior } is rejected by the SDK at runtime.
}

contract MultiTurnPromptStream {
    next_message: (session: Session) -> Any

    @invariant StreamExhaustion
        -- The stream yields the initial prompt followed by zero or
        -- more follow-up messages, then signals end-of-stream. After
        -- end-of-stream, subsequent calls signal end-of-stream
        -- (idempotent); the SDK does not call next_message after
        -- end-of-stream. The number of follow-up messages yielded is
        -- bounded by session.input.max_user_follow_ups; when the cap
        -- is zero or has been reached, the stream signals
        -- end-of-stream immediately after the initial prompt.
}

contract SessionPersistence {
    write_jsonl: (session_id: String, message: Any) -> Any

    @invariant FullConversationPreserved
        -- Every message exchanged with the agent (user, assistant text,
        -- tool uses, tool results, thinking, system) is written to the
        -- SDK's native JSONL file. scuttlerun surfaces the file's path
        -- in the preamble but never modifies its contents.
}

contract AbortableExecution {
    abort: (session: Session) -> Any
    interrupt: (session: Session) -> Any

    @invariant TerminatesPromptlyOnAbort
        -- After abort and interrupt are signalled, the iterator stops
        -- producing messages within a bounded delay determined by the
        -- in-flight SDK iteration. scuttlerun additionally checks an
        -- internal flag at the top of each loop iteration to break
        -- promptly without waiting for the iterator to drain.
}

contract StructuredOutputParse {
    parse: (system_prompt: String, user_message: String, schema: Any) -> Any

    @invariant SchemaConformance
        -- The returned parsed_output conforms to the requested schema.
        -- The call is retried with bounded exponential backoff on
        -- failure before reporting a structured-output error to the
        -- caller.

    @invariant UsageReported
        -- The response carries token-usage counts (input, output,
        -- cache-creation, cache-read) used by scuttlerun for cost
        -- accounting.
}
